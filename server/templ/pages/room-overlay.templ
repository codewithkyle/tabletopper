package pages
templ roomOverlay(data RoomPageData) {
	<div
		data-pawn-overlay
		hidden
		class={ surfacePanel + " pointer-events-none absolute top-0 left-0 z-10 flex max-w-64 flex-col gap-1 rounded-box p-1.5 text-xs will-change-transform" }
	>
		<div data-overlay-one hidden class="flex flex-col gap-1">
			<p data-overlay-name class="m-0 truncate font-semibold"></p>
			<div class="flex items-center gap-2 text-[10px] text-base-content/70">
				<span data-overlay-hp class="truncate"></span>
				<span data-overlay-ac class="truncate"></span>
			</div>
		</div>
		<div data-overlay-many hidden class="pointer-events-auto flex flex-col gap-1">
			<p data-overlay-count class="m-0 font-semibold"></p>
			if data.IsGM() {
				<select
					data-overlay-layer
					name="layer"
					aria-label="Move to floor"
					class="select select-xs w-full"
					hx-post={ "/rooms/" + data.ID + "/pawns/layer" }
					hx-trigger="change[this.value !== '']"
					hx-swap="none"
					hx-vals=""
				></select>
				<div class="flex gap-1">
					<button
						type="button"
						data-overlay-shown
						class="btn btn-xs flex-1"
						hx-post={ "/rooms/" + data.ID + "/pawns/shown" }
						hx-swap="none"
						hx-vals=""
					></button>
					<button
						type="button"
						data-overlay-remove
						class="btn btn-xs btn-error flex-1"
						hx-delete={ "/rooms/" + data.ID + "/pawns" }
						hx-swap="none"
						hx-vals=""
						hx-confirm="Remove them from the table. This cannot be undone."
						data-confirm-heading="Remove these pawns?"
						data-confirm-label="Remove"
					>Remove</button>
				</div>
			}
		</div>
	</div>
}
templ roomRemoveKey(data RoomPageData) {
	<button
		type="button"
		data-pawn-remove
		hidden
		hx-delete={ "/rooms/" + data.ID + "/pawns" }
		hx-swap="none"
		hx-vals=""
		hx-confirm="Remove what is selected from the table. This cannot be undone."
		data-confirm-heading="Remove from the table?"
		data-confirm-label="Remove"
	>Remove</button>
}
