package pages

import "tabletopper/templ/layouts"

templ EditCharacter(data EditCharacterPageData) {
	@layouts.Base("Character Editor | Tabletopper") {
		@editCharacterShell(data.CharacterID, characterTabMain) {
			@characterPanels(data)
		}
	}
}

templ editCharacterShell(characterID string, active string) {
	<character-editor class="relative block h-screen min-h-dvh w-screen px-4 pt-4 opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]">
		<div class="grid h-full w-full grid-rows-[auto_auto_minmax(0,1fr)] gap-3">
			<div class="flex flex-wrap items-end justify-between gap-3 p-2 pb-0 max-[640px]:items-stretch">
				<div>
					<h1 class="mt-0.5 mb-0 font-serif text-[2rem] leading-tight">Edit Character</h1>
				</div>
				<div class="flex items-center gap-4 max-[640px]:w-full">
					<a
						href="/characters"
						class="btn max-[640px]:flex-1"
					>
						Back
					</a>
				</div>
			</div>
			@characterTabs(characterID, active)
			<div class="grid min-h-0 content-start gap-4 overflow-auto pb-4">
				{ children... }
			</div>
		</div>
	</character-editor>
}

templ characterPanels(data EditCharacterPageData) {
	{{ base := "/characters/" + data.CharacterID }}
	@savingPanel("Identity", base+"/identity", "identity") {
		<div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
			<div class="col-span-2 max-[900px]:col-auto">
				@textField("name", "Character Name", data.Name, "", true)
			</div>
			@textField("classes", "Class & Level Notes", data.Classes, "Cleric 3, Fighter 1", true)
			@textField("background", "Background", data.Background, "", false)
			@textField("race", "Species / Race", data.Race, "Human", true)
			@selectField("alignment", "Alignment", alignmentOptions, data.Alignment, true)
			@selectField("size", "Size", sizeOptions, data.Size, true)
		</div>
	}
	@savingPanel("Abilities", base+"/abilities", "abilities") {
		<div class="grid grid-cols-6 gap-4 max-[1160px]:grid-cols-3 max-[640px]:grid-cols-2">
			@numberField("str", "Strength", data.Str, true)
			@numberField("dex", "Dexterity", data.Dex, true)
			@numberField("con", "Constitution", data.Con, true)
			@numberField("int", "Intelligence", data.Int, true)
			@numberField("wis", "Wisdom", data.Wis, true)
			@numberField("cha", "Charisma", data.Cha, true)
		</div>
	}
	@savingPanel("Core Stats", base+"/core-stats", "core-stats") {
		<div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
			@numberField("xp", "Experience", data.XP, true)
			@textField("speed", "Speed", data.Speed, "", false)
			@numberField("ac", "Armor Class", data.AC, true)
			@numberField("initiative_bonus", "Initiative Bonus", data.InitiativeBonus, true)
			@numberField("max_hp", "Hit Point Maximum", data.MaxHP, true)
			@numberField("current_hp", "Current Hit Points", data.CurrentHP, true)
			@numberField("temp_hp", "Temporary Hit Points", data.TempHP, true)
			@numberField("spell_save_dc", "Spell Save DC", data.SpellSaveDC, true)
			@numberField("spell_atk_bonus", "Spell Attack Bonus", data.SpellAtkBonus, true)
		</div>
	}
	@savingPanel("Proficiencies & Training", base+"/proficiencies", "proficiencies") {
		<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
			@textField("languages", "Languages", data.Languages, "", false)
			@textField("proficiencies", "Other Proficiencies", data.Proficiencies, "Medium armor, thieves tools", true)
		</div>
	}
	<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
		<div class="grid content-start gap-4">
			@savingPanel("Saving Throws", base+"/bonuses/saving_throws", "saving_throws") {
				@savingThrowsTable(data.SavingThrows)
			}
			@savingPanel("Skills", base+"/bonuses/skills", "skills") {
				@skillsTable(data.Skills)
			}
		</div>
		<div class="grid content-start gap-4">
			@savingPanel("Features & Traits", base+"/features", FeaturesPanel) {
				@featuresTable(data.Features)
			}
			@sheetPanel("Equipment") {
				@equippedItems(data.CharacterID, data.Equipped)
			}
		</div>
	</div>
	<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
		@sheetPanel("Prepared Spells") {
			@preparedSpells(data.CharacterID, data.Prepared)
		}
		@sheetPanel("Spell Slots") {
			@spellSlotsOverview(data.CharacterID, data.SpellSlots)
		}
	</div>
}
