package pages

import "tabletopper/templ/layouts"

templ EditCharacter(data EditCharacterPageData) {
	@layouts.Base("Character Editor | Tabletopper") {
		@editCharacterShell(data.CharacterID, data.Header, characterTabMain, shellLayout{}) {
			@characterPanels(data)
		}
	}
}

templ editCharacterShell(characterID string, header CharacterHeader, active string, layout shellLayout) {
	<character-editor class="relative block h-screen min-h-dvh w-screen opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]">
		<div class="grid h-full w-full grid-rows-[auto_minmax(0,1fr)]">
			@characterBar(characterID, header, active, layout)
			{{ content := "grid min-h-0 content-start gap-4 overflow-auto px-6 py-4 max-[900px]:px-4" }}
			if layout.Fill {
				{{ content = "grid min-h-0 grid-rows-[minmax(0,1fr)] gap-4 overflow-hidden px-6 py-4 max-[900px]:px-4" }}
			}
			<div class={ content }>
				{ children... }
			</div>
		</div>
	</character-editor>
}

templ characterPanels(data EditCharacterPageData) {
	{{ base := "/characters/" + data.CharacterID }}
	@savingPanel("Identity", base+"/identity", "identity") {
		<div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
			<div class="col-span-2 max-[900px]:col-auto">
				@textField("name", "Character Name", data.Name, "", true)
			</div>
			@textField("classes", "Class & Level Notes", data.Classes, "Cleric 3, Fighter 1", true)
			@textField("background", "Background", data.Background, "", false)
			@textField("race", "Species / Race", data.Race, "Human", true)
			@selectField("alignment", "Alignment", alignmentOptions, data.Alignment, true)
			@selectField("size", "Size", sizeOptions, data.Size, true)
		</div>
	}
	@savingPanel("Abilities", base+"/abilities", "abilities") {
		<div class="grid grid-cols-6 gap-4 max-[1160px]:grid-cols-3 max-[640px]:grid-cols-2">
			@abilityField("str", "Strength", data.Str, data.Derived.StrMod)
			@abilityField("dex", "Dexterity", data.Dex, data.Derived.DexMod)
			@abilityField("con", "Constitution", data.Con, data.Derived.ConMod)
			@abilityField("int", "Intelligence", data.Int, data.Derived.IntMod)
			@abilityField("wis", "Wisdom", data.Wis, data.Derived.WisMod)
			@abilityField("cha", "Charisma", data.Cha, data.Derived.ChaMod)
		</div>
	}
	@savingPanel("Core Stats", base+"/core-stats", "core-stats") {
		<div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
			@numberField("xp", "Experience", data.XP, true)
			@textField("speed", "Speed", data.Speed, "", false)
			@numberField("ac", "Armor Class", data.AC, true)
			@signedNumberField("initiative_bonus", "Initiative Bonus", data.InitiativeBonus)
			@selectField("spellcasting_ability", "Spellcasting Ability", spellcastingAbilityOptions, data.SpellcastingAbility, true)
			@signedNumberField("spell_bonus_misc", "Spell Bonus (items, feats)", data.SpellBonusMisc)
		</div>
		<div class="flex flex-wrap items-center gap-x-8 gap-y-2 rounded-field border-2 border-base-300 p-3">
			<span class="flex items-baseline gap-3">
				<span class="text-sm font-semibold tracking-wider uppercase text-base-content/75">Spell Save DC</span>
				@derivedValue("spell-save-dc", data.Derived.SpellSaveDC, false)
			</span>
			<span class="flex items-baseline gap-3">
				<span class="text-sm font-semibold tracking-wider uppercase text-base-content/75">Spell Attack</span>
				@derivedValue("spell-attack-bonus", data.Derived.SpellAttackBonus, false)
			</span>
		</div>
	}
	@savingPanel("Vitals", base+"/vitals", "vitals") {
		<div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
			@numberField("max_hp", "Hit Point Maximum", data.MaxHP, true)
			@numberField("current_hp", "Current Hit Points", data.CurrentHP, true)
			@numberField("temp_hp", "Temporary Hit Points", data.TempHP, true)
			@wordField("hit_dice", "Hit Dice", data.HitDice, "3d8")
			@countField("hit_dice_spent", "Hit Dice Spent", data.HitDiceSpent, HitDiceSpentLimit)
			@countField("exhaustion", "Exhaustion", data.Exhaustion, ExhaustionLimit)
			@deathSaveField("death_save_successes", "Death Save Successes", data.DeathSaveSuccesses)
			@deathSaveField("death_save_failures", "Death Save Failures", data.DeathSaveFailures)
			@toggleField("heroic_inspiration", "Heroic Inspiration", data.HeroicInspiration)
		</div>
	}
	@sheetPanel("Attacks") {
		@attacksTable(data.CharacterID, data.Attacks)
	}
	@savingPanel("Proficiencies & Training", base+"/proficiencies", "proficiencies") {
		<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
			@textField("languages", "Languages", data.Languages, "", false)
			@textField("proficiencies", "Other Proficiencies", data.Proficiencies, "Medium armor, thieves tools", true)
		</div>
	}
	<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
		<div class="grid content-start gap-4">
			@savingPanel("Saving Throws", base+"/bonuses/saving_throws", "saving_throws") {
				@savingThrowsTable(data.Derived.SavingThrows)
			}
			@savingPanel("Skills", base+"/bonuses/skills", "skills") {
				@skillsTable(data.Derived.Skills, data.Derived.PassivePerception)
			}
		</div>
		<div class="grid content-start gap-4">
			@savingPanel("Features & Traits", base+"/features", FeaturesPanel) {
				@featuresTable(data.Features)
			}
			@sheetPanel("Equipment") {
				@equippedItems(data.CharacterID, data.Equipped)
			}
		</div>
	</div>
	<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
		@sheetPanel("Prepared Spells") {
			@preparedSpells(data.CharacterID, data.Prepared)
		}
		@sheetPanel("Spell Slots") {
			@spellSlotsOverview(data.CharacterID, data.SpellSlots)
		}
	</div>
	<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
		@savingPanel("Personality", base+"/personality", "personality") {
			<div class="grid gap-4">
				@proseField("personality_traits", "Personality Traits", data.PersonalityTraits, "I laugh loudest when the plan is falling apart.")
				@proseField("ideals", "Ideals", data.Ideals, "Freedom. Every chain is one worth breaking.")
				@proseField("bonds", "Bonds", data.Bonds, "The people I served with. I would still die for them.")
				@proseField("flaws", "Flaws", data.Flaws, "I cannot walk past a locked door.")
			</div>
		}
		@savingPanel("Appearance", base+"/appearance", "appearance") {
			<div class="@container">
				<div class="grid grid-cols-1 gap-4 @[22rem]:grid-cols-2 @[33rem]:grid-cols-3">
					@wordField("age", "Age", data.Age, "27")
					@wordField("height", "Height", data.Height, "5 ft. 10 in.")
					@wordField("weight", "Weight", data.Weight, "160 lb.")
					@wordField("eyes", "Eyes", data.Eyes, "Grey")
					@wordField("skin", "Skin", data.Skin, "Sun-darkened")
					@wordField("hair", "Hair", data.Hair, "Black, close-cropped")
				</div>
			</div>
		}
	</div>
}
