package pages

import (
	"main/internal/session"
	"main/templ/layouts"
)

var editCharacterSettings layouts.BaseTemplateSettings = layouts.BaseTemplateSettings{
	Title: "Character Editor | Tabletopper",
}

templ EditCharacter(session session.UserSession, data EditCharacterPageData) {
	{{ editCharacterSettings.Session = session }}
	{{ editCharacterSettings.Content = editCharacterContent(data) }}
	@layouts.Base(editCharacterSettings)
}

templ editCharacterContent(data EditCharacterPageData) {
	<character-editor class="relative block h-screen min-h-dvh w-screen px-4 pt-4 opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]">
		<form class="grid h-full w-full grid-rows-[auto_minmax(0,1fr)] gap-3" hx-post={ data.FormAction } hx-status:422="target:#new-character-form-errors" hx-swap="outerHTML">
			<div class="flex flex-wrap items-end justify-between gap-3 p-2 max-[640px]:items-stretch">
				<div>
					<h1 class="mt-0.5 mb-0 font-serif text-[2rem] leading-tight">Edit Character</h1>
				</div>
				<div class="flex items-center gap-4 max-[640px]:w-full">
					<a
						href="/characters"
						type="button"
						class="btn max-[640px]:flex-1"
					>
						Back
					</a>
					<button
						type="submit"
						class="btn btn-success max-[640px]:flex-1"
					>
						Save character
					</button>
				</div>
			</div>
			<div class="min-h-0 overflow-hidden">
				@NewCharacterFormErrors([]string{})
				<div class="grid h-full gap-4 overflow-auto pb-4">
					@sheetSection("Identity") {
						<div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
							<div class="col-span-2 max-[900px]:col-auto">
								@textField("name", "Character Name", data.Name, "", true)
							</div>
							@textField("classes", "Class & Level Notes", data.Classes, "Cleric 3, Fighter 1", true)
							@textField("background", "Background", data.Background, "", false)
							@textField("race", "Species / Race", data.Race, "Human", true)
							@selectField("alignment", "Alignment", alignmentOptions, data.Alignment, true)
							@selectField("size", "Size", sizeOptions, data.Size, true)
						</div>
					}

					@sheetSection("Abilities") {
						<div class="grid grid-cols-6 gap-4 max-[1160px]:grid-cols-3 max-[640px]:grid-cols-2">
							@numberField("str", "Strength", data.Str, true)
							@numberField("dex", "Dexterity", data.Dex, true)
							@numberField("con", "Constitution", data.Con, true)
							@numberField("int", "Intelligence", data.Int, true)
							@numberField("wis", "Wisdom", data.Wis, true)
							@numberField("cha", "Charisma", data.Cha, true)
						</div>
					}

					@sheetSection("Core Stats") {
						<div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
							@numberField("xp", "Experience", data.Xp, true)
							@textField("speed", "Speed", data.Speed, "", false)
							@numberField("ac", "Armor Class", data.Ac, true)
							@numberField("initiative_bonus", "Initiative Bonus", data.InitiativeBonus, true)
							@numberField("max_hp", "Hit Point Maximum", data.MaxHP, true)
							@numberField("current_hp", "Current Hit Points", data.CurrentHP, true)
							@numberField("temp_hp", "Temporary Hit Points", data.TempHP, true)
							@numberField("spell_save_dc", "Spell Save DC", data.SpellSaveDC, true)
							@numberField("spell_atk_bonus", "Spell Attack Bonus", data.SpellAtkBonus, true)
						</div>
					}

					@sheetSection("Proficiencies & Training") {
						<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
							@textField("languages", "Languages", data.Languages, "", false)
							@textField("proficiencies", "Other Proficiencies", data.Proficiencies, "Medium armor, thieves tools", true)
						</div>
					}

					<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
						<div class="grid content-start gap-4">
							@sheetSection("Saving Throws") {
								<saving-throws-table data-name="saving_throws" data-label="" data-values={ data.SavingThrowsJSON }></saving-throws-table>
							}
							@sheetSection("Skills") {
								<skills-table data-name="skills" data-label="" data-values={ data.SkillsJSON }></skills-table>
							}
						</div>
						<div class="grid content-start gap-4">
							@sheetSection("Features & Traits") {
								<monster-info-table
									data-name="features"
									data-label=""
									data-add-label="Add Feature or Trait"
									data-rows={ data.FeaturesJSON }
								></monster-info-table>
							}
							@sheetSection("Equipment") {
								<monster-info-table
									data-name="weapons"
									data-label=""
									data-add-label="Add Equipment"
									data-rows={ data.WeaponsJSON }
								></monster-info-table>
							}
						</div>
					</div>

					@sheetSection("Resources") {
						<monster-info-table
							data-name="resources"
							data-label=""
							data-add-label="Add Resource"
							data-rows={ data.ResourcesJSON }
						></monster-info-table>
					}

					@sheetSection("Spellcasting") {
						<spell-slots-table
							data-name="spells"
							data-label=""
							data-add-label="Add Spell"
							data-levels={ data.SpellSlotsJSON }
						></spell-slots-table>
					}
				</div>
			</div>
		</form>
	</character-editor>
}
