package pages
const initiativeColumn = "flex w-18 shrink-0 flex-col items-center"
const initiativeTile = "block w-18 shrink-0 p-1 shadow-panel"
const initiativeAura = "aura aura-silver"
const initiativePortraitBox = "relative block aspect-[2/3] w-full overflow-hidden rounded-sm bg-black/40"
const initiativeStaticName = "absolute inset-0 grid place-content-center px-0.5 text-center text-[10px] leading-tight text-white"
const initiativePlate = "block w-18 truncate rounded-b-md px-1 text-center text-xs leading-6 font-medium"
const initiativeUnderlay = "absolute inset-x-0 bottom-0 bg-black/55 px-0.5 text-center text-[10px] leading-4 text-white"
templ RoomInitiative(data RoomInitiativeData) {
	<div
		id={ RoomInitiativeID }
		class="pointer-events-none absolute inset-x-0 top-0 z-20 flex flex-col items-center gap-1 p-2"
		hx-get={ data.Path() }
		hx-trigger={ data.Trigger() }
		hx-sync="this:queue last"
		hx-swap="outerHTML"
		hidden?={ data.Empty }
		data-turns
		if data.IsGM {
			data-reorder
		}
	>
		<div data-entries class="pointer-events-auto flex max-w-full items-start gap-2 overflow-x-auto p-4 select-none">
			for _, e := range data.Entries {
				@initiativeEntry(data, e)
			}
		</div>
		@initiativeConditions(data.ActingConditions())
		if data.IsGM {
			<button
				type="button"
				data-turn-next
				hidden
				hx-post={ data.NextPath() }
				hx-swap="none"
			>Next turn</button>
			<button
				type="button"
				data-turn-order
				hidden
				hx-post={ data.OrderPath() }
				hx-swap="none"
				hx-vals=""
			>Reorder</button>
		}
	</div>
}
templ initiativeEntry(data RoomInitiativeData, e RoomInitiativeEntry) {
	<div
		data-entry={ e.ID }
		class={ initiativeColumn }
		title={ e.Name }
		if e.Side != "" {
			data-side={ e.Side }
		}
		if e.Active {
			data-turn-active
		}
		if e.Solo != "" {
			data-entry-solo={ e.Solo }
		}
	>
		if e.Active {
			<span data-turn-aura class={ initiativeAura }>
				@initiativeFrame(data, e)
				<span data-entry-plate class={ initiativePlate }>{ e.Name }</span>
			</span>
			@initiativeTurn(data, e)
		} else {
			@initiativeFrame(data, e)
		}
		if data.IsGM {
			<button
				type="button"
				data-entry-remove
				hidden
				hx-delete={ data.RemovePath(e) }
				hx-swap="none"
			>Remove</button>
		}
	</div>
}
templ initiativeFrame(data RoomInitiativeData, e RoomInitiativeEntry) {
	if data.IsGM {
		<button
			type="button"
			data-entry-tile
			class={ initiativeTile, "cursor-pointer", templ.KV("rounded-md", !e.Active), templ.KV("rounded-t-md", e.Active) }
			aria-label={ data.ActivateLabel(e) }
			hx-post={ data.ActivatePath(e) }
			hx-swap="none"
		>
			@initiativePortrait(data, e)
		</button>
	} else {
		<div
			data-entry-tile
			class={ initiativeTile, templ.KV("rounded-md", !e.Active), templ.KV("rounded-t-md", e.Active) }
		>
			@initiativePortrait(data, e)
		</div>
	}
}
templ initiativePortrait(data RoomInitiativeData, e RoomInitiativeEntry) {
	<span
		data-portrait
		class={ initiativePortraitBox }
		if e.Band != "" {
			data-band={ e.Band }
		}
		if e.Blood != "" {
			data-blood={ e.Blood }
		}
	>
		<span data-face class="absolute inset-0 block">
			<span data-entry-name class={ initiativeStaticName }>
				<span class="line-clamp-4">{ e.Name }</span>
			</span>
			if e.Image != "" {
				<img src={ e.Image } alt="" class="absolute inset-0 h-full w-full object-cover select-none"/>
			}
		</span>
		<span data-pulse aria-hidden="true" class="pointer-events-none absolute inset-0"></span>
		<span
			data-skull
			aria-hidden="true"
			class="pointer-events-none absolute inset-0 grid place-content-center text-[2.8rem] leading-none"
		></span>
		if e.Grouped() {
			@initiativePips(e)
		} else if data.ShowHP(e) {
			<span class={ initiativeUnderlay, "truncate" }>{ e.HP }</span>
		}
		if e.Hidden {
			<span class="badge badge-xs badge-warning absolute top-0.5 left-1/2 -translate-x-1/2">Hidden</span>
		}
	</span>
}
templ initiativePips(e RoomInitiativeEntry) {
	<span data-entry-pips class={ initiativeUnderlay, "flex flex-wrap items-center justify-center gap-0.5 py-0.5" }>
		for _, p := range e.Pips {
			<span
				data-pip
				class="block size-1.5 shrink-0 rounded-full"
				if p.Band != "" {
					data-band={ p.Band }
				}
			></span>
		}
		if e.Count != "" {
			{ e.Count }
		}
	</span>
}
templ initiativeTurn(data RoomInitiativeData, e RoomInitiativeEntry) {
	if !data.IsGM && e.Mine {
		<button
			type="button"
			data-turn-next
			class="btn btn-primary mt-1 h-auto w-18 flex-col gap-0.5 px-1 py-1.5"
			hx-post={ data.NextPath() }
			hx-swap="none"
		>
			<span class="text-xs leading-none">End turn</span>
			<span data-turn-timer data-turn-tone="plain" class="font-mono text-xs leading-none tabular-nums opacity-80">0:00</span>
		</button>
	}
}
templ initiativeConditions(chips []RoomPawnCondition) {
	if len(chips) > 0 {
		<span class="flex max-w-full flex-wrap justify-center gap-1 px-1">
			for _, c := range chips {
				@pawnConditionChip(c)
			}
		</span>
	}
}
templ roomInitiativeMount(data RoomPageData) {
	<div
		id={ RoomInitiativeID }
		hidden
		class="pointer-events-none absolute inset-x-0 top-0 z-20 flex flex-col items-center gap-1 p-2"
		hx-get={ data.InitiativePath() }
		hx-trigger={ InitiativeLoadTrigger }
		hx-sync="this:queue last"
		hx-swap="outerHTML"
		data-turns
	></div>
}
templ roomInitiativeMenu(data RoomPageData) {
	<ul
		data-entry-menu
		hidden
		class="menu menu-sm absolute top-0 left-0 z-30 w-52 rounded-box border border-base-300 bg-panel/95 p-1 shadow-panel backdrop-blur-sm"
	>
		<li data-entry-menu-name class="menu-title block w-full truncate text-xs"></li>
		<li data-entry-menu-details hidden>
			<button type="button">Open pawn panel</button>
		</li>
		<li>
			<button type="button" data-entry-menu-remove class="text-error">Remove from tracker</button>
		</li>
	</ul>
}
templ RoomInitiativeEntryForm(data RoomInitiativeEntryData) {
	<form
		class="flex flex-col gap-3"
		hx-post={ data.SavePath() }
		hx-swap="none"
		hx-status:422={ "target:#errors-" + RoomInitiativeEntryPanel + ",swap:outerHTML" }
	>
		<h2 class="font-serif text-lg font-bold">Add to the turn order</h2>
		@PanelFormErrors(RoomInitiativeEntryPanel, data.Errors)
		<label class="flex flex-col gap-0.5">
			<span class="text-xs text-base-content/60">What acts on this count</span>
			<input
				type="text"
				name="name"
				required
				autocomplete="off"
				maxlength={ EntryNameMax }
				placeholder="Lair action"
				class="input input-sm w-full"
			/>
		</label>
		<div class="flex justify-end gap-2">
			<button
				type="button"
				class="btn border-base-content/50"
				hx-on:click="window.dispatchEvent(new CustomEvent('modal:close'))"
			>Close</button>
			<button type="submit" class="btn btn-primary">Add</button>
		</div>
	</form>
}
