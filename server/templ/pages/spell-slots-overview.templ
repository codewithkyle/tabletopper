package pages

templ spellSlotsOverview(characterID string, live SheetLive, levels []SpellLevel) {
	{{ active := activeSpellLevels(levels) }}
	if len(active) == 0 {
		<p class="text-base-content/75">
			No spell levels in use yet. Add a spell or set a slot count on one of the levels above and it appears here.
		</p>
	} else {
		<div class="grid w-full gap-3">
			for _, level := range active {
				@spellLevelSummary(characterID, live, level)
			}
		</div>
	}
}

templ spellLevelSummary(characterID string, live SheetLive, level SpellLevel) {
	if level.Level == 0 {
		<div class={ surfaceInset + " p-3" }>
			<div class="flex flex-wrap items-center justify-between gap-3">
				@spellLevelHeading(characterID, live, level)
				<span class="text-sm text-base-content/60">Unlimited</span>
			</div>
		</div>
	} else {
		@spellSlotsForm(characterID, level) {
			@spellLevelHeading(characterID, live, level)
		}
	}
}

const spellLevelLink = "link font-serif text-base leading-none font-bold"

templ spellLevelHeading(characterID string, live SheetLive, level SpellLevel) {
	<span class="flex min-w-0 flex-col items-start gap-1">
		if live.On() {
			<button
				type="button"
				class={ spellLevelLink }
				hx-get={ live.LevelPath(level.Level) }
				hx-target={ "#" + SheetBodyID }
				hx-swap="outerHTML"
			>{ SpellLevelName(level.Level) }</button>
		} else {
			<a href={ SpellLevelEditPath(characterID, level.Level) } class={ spellLevelLink }>{ SpellLevelName(level.Level) }</a>
		}
		<span class="text-xs font-semibold text-base-content/75">{ SpellCountLabel(level.Count) }</span>
	</span>
}
