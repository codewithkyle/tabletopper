package pages

import (
	"strconv"
	"tabletopper/templ/layouts"
)

templ MapAssets(maps []MapAsset) {
	@layouts.Base("Maps | Asset Manager | Tabletopper") {
		@assetsShell(assetTabMaps, mapUploadButton()) {
			@assetGrid("maps", "No maps yet.", "A map is the board you play on. Upload one and it is cut into tiles, so it stays sharp however far in you zoom.") {
				for _, m := range maps {
					@MapCard(m)
				}
			}
		}
	}
}

templ TokenAssets() {
	@layouts.Base("Tokens | Asset Manager | Tabletopper") {
		@assetsShell(assetTabTokens, nil) {
			@assetGrid("tokens", "No tokens yet.", "A token is a thing on the board that is not a creature -- a wagon, a rowboat, a barricade. They sit on their own layer, under the pawns.")
		}
	}
}

templ AvatarAssets() {
	@layouts.Base("Avatars | Asset Manager | Tabletopper") {
		@assetsShell(assetTabAvatars, nil) {
			@assetGrid("avatars", "No avatars yet.", "A face to put on an NPC. Gather them here before a session, and spawning one mid-game is a search rather than a hunt through your folders.")
		}
	}
}

templ MusicAssets() {
	@layouts.Base("Music | Asset Manager | Tabletopper") {
		@assetsShell(assetTabMusic, nil) {
			@assetGrid("music", "No music yet.", "The tracks you play behind a session -- a battle, a tavern, an hour of rain. One plays at a time and loops until you stop it or choose another.")
		}
	}
}

templ assetsShell(active string, actions templ.Component) {
	<assets-page class="relative block h-screen min-h-dvh w-screen">
		<div class="grid h-full w-full grid-rows-[auto_minmax(0,1fr)]">
			@appBar() {
				<div class={ assetGutter + " flex flex-wrap items-center justify-between gap-4 py-3" }>
					<div class="flex min-w-0 items-center gap-3">
						@backLink(homeBack())
						<h1 class="m-0 font-serif text-[clamp(1.45rem,2.4vw,2.05rem)] leading-none">Asset Manager</h1>
					</div>
					if actions != nil {
						<div class="flex flex-row flex-nowrap items-center">
							@actions
						</div>
					}
				</div>
				@assetTabs(active)
			}
			{ children... }
		</div>
	</assets-page>
}

templ assetGrid(id string, heading string, blurb string) {
	<section id={ id } class={ assetGutter + " grid min-h-0 w-full grid-cols-5 content-start gap-4 overflow-y-auto py-4" }>
		{ children... }
		<div class="col-span-full hidden only:block">
			@assetEmptyState(heading, blurb)
		</div>
	</section>
}

templ assetEmptyState(heading string, blurb string) {
	<div class={ sheetSurface + " mx-auto mt-[min(14vh,7rem)] max-w-md text-center" }>
		<div class="card-body p-8">
			<p class="m-0 font-serif text-2xl">{ heading }</p>
			<p class="m-0 mt-4 text-base-content/75">{ blurb }</p>
		</div>
	</div>
}

templ mapUploadButton() {
	<label
		for="map-upload"
		class="btn btn-primary relative"
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-camera-up"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 20h-7a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2h1a2 2 0 0 0 2 -2a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1a2 2 0 0 0 2 2h1a2 2 0 0 1 2 2v3.5"></path><path d="M12 16a3 3 0 1 0 0 -6a3 3 0 0 0 0 6"></path><path d="M19 22v-6"></path><path d="M22 19l-3 -3l-3 3"></path></svg>
		Upload map
		<input
			class="absolute top-0 left-0 h-0 w-0 opacity-0"
			id="map-upload"
			type="file"
			name="map"
			accept="image/png, image/jpeg, image/webp"
			required
			hx-post="/assets/maps"
			hx-swap="afterbegin"
			hx-target="#maps"
			hx-encoding="multipart/form-data"
		/>
	</label>
}

templ MapCard(m MapAsset) {
	<asset-card
		class={ sheetSurface + " mb-auto p-4" }
		if m.Polling() {
			data-quiet
			hx-get={ m.CardURL() }
			hx-trigger="every 2s"
			hx-swap="outerMorph"
		}
	>
		<div class="relative mb-2 flex aspect-square w-full items-center justify-center overflow-hidden rounded bg-base-content/5">
			if m.Usable() {
				<img class="absolute inset-0 h-full w-full object-cover" src={ "/assets/images/" + m.ID + "/preview" } alt=""/>
			} else {
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-10 text-base-content/25 icon icon-tabler icons-tabler-outline icon-tabler-photo"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M15 8h.01"></path><path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z"></path><path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5"></path><path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3"></path></svg>
			}
			if m.Polling() {
				<div class="absolute inset-x-0 bottom-0 flex items-center gap-2 bg-base-100/85 px-2 py-1 text-xs">
					<span class="loading loading-spinner loading-xs"></span>
					Building tiles
				</div>
			}
			if m.Retryable() {
				<div class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 bg-error/90 px-2 py-1 text-xs text-error-content">
					Tiling gave up
					<button
						class="btn btn-xs"
						hx-post={ "/assets/maps/" + m.ID + "/tiles" }
						hx-target="closest asset-card"
						hx-swap="outerHTML"
					>
						Retry
					</button>
				</div>
			}
		</div>
		<input
			id={ "map-name-" + m.ID }
			class="mb-1 block h-9 w-full truncate rounded border border-transparent bg-transparent font-serif text-2xl transition-all duration-150 ease-in-out hover:border-base-content/15 hover:bg-base-content/5 hover:px-2 focus:border-base-300 focus:bg-transparent focus:px-2"
			type="text"
			value={ m.Name }
			name="map-name"
			required
			maxlength={ strconv.Itoa(AssetNameLimit) }
			hx-trigger="input changed delay:1s"
			hx-patch={ "/assets/maps/" + m.ID + "/name" }
			hx-swap="none"
		/>
		<div class="flex flex-row flex-nowrap items-center justify-between gap-2">
			<div class="min-w-0 flex-1">
				<code class="mr-auto inline-block h-6 max-w-full flex-1 overflow-hidden rounded bg-base-content/5 px-1 text-xs leading-6 text-ellipsis whitespace-nowrap">{ m.FileName }</code>
			</div>
			<div class="flex flex-row items-center gap-1">
				<div class="tooltip" data-tip="Replace">
					<label
						for={ "map-replace-" + m.ID }
						class="btn btn-soft btn-square"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-replace"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M8 2h-4a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h4a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2z"></path><path d="M20 14h-4a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h4a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2z"></path><path d="M16.707 2.293a1 1 0 0 1 .083 1.32l-.083 .094l-1.293 1.293h3.586a3 3 0 0 1 2.995 2.824l.005 .176v3a1 1 0 0 1 -1.993 .117l-.007 -.117v-3a1 1 0 0 0 -.883 -.993l-.117 -.007h-3.585l1.292 1.293a1 1 0 0 1 -1.32 1.497l-.094 -.083l-3 -3a.98 .98 0 0 1 -.28 -.872l.036 -.146l.04 -.104c.058 -.126 .14 -.24 .245 -.334l2.959 -2.958a1 1 0 0 1 1.414 0z"></path><path d="M3 12a1 1 0 0 1 .993 .883l.007 .117v3a1 1 0 0 0 .883 .993l.117 .007h3.585l-1.292 -1.293a1 1 0 0 1 -.083 -1.32l.083 -.094a1 1 0 0 1 1.32 -.083l.094 .083l3 3a.98 .98 0 0 1 .28 .872l-.036 .146l-.04 .104a1.02 1.02 0 0 1 -.245 .334l-2.959 2.958a1 1 0 0 1 -1.497 -1.32l.083 -.094l1.291 -1.293h-3.584a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-3a1 1 0 0 1 1 -1z"></path></svg>
						<input
							class="absolute top-0 left-0 h-0 w-0 opacity-0"
							id={ "map-replace-" + m.ID }
							type="file"
							name="map"
							accept="image/png, image/jpeg, image/webp"
							required
							hx-post={ "/assets/maps/" + m.ID }
							hx-target="closest asset-card"
							hx-swap="outerHTML"
							hx-encoding="multipart/form-data"
						/>
					</label>
				</div>
				<div class="tooltip" data-tip="Delete">
					<button
						class="btn btn-soft btn-error btn-square"
						hx-confirm={ "You are about to delete your your map " + m.Name + ". This action cannot be undone." }
						hx-delete={ "/assets/maps/" + m.ID }
						hx-target="closest asset-card"
						hx-swap="delete"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-trash-x"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M20 6a1 1 0 0 1 .117 1.993l-.117 .007h-.081l-.919 11a3 3 0 0 1 -2.824 2.995l-.176 .005h-8c-1.598 0 -2.904 -1.249 -2.992 -2.75l-.005 -.167l-.923 -11.083h-.08a1 1 0 0 1 -.117 -1.993l.117 -.007h16zm-9.489 5.14a1 1 0 0 0 -1.218 1.567l1.292 1.293l-1.292 1.293l-.083 .094a1 1 0 0 0 1.497 1.32l1.293 -1.292l1.293 1.292l.094 .083a1 1 0 0 0 1.32 -1.497l-1.292 -1.293l1.292 -1.293l.083 -.094a1 1 0 0 0 -1.497 -1.32l-1.293 1.292l-1.293 -1.292l-.094 -.083z"></path><path d="M14 2a2 2 0 0 1 2 2a1 1 0 0 1 -1.993 .117l-.007 -.117h-4l-.007 .117a1 1 0 0 1 -1.993 -.117a2 2 0 0 1 1.85 -1.995l.15 -.005h4z"></path></svg>
					</button>
				</div>
			</div>
		</div>
	</asset-card>
}
