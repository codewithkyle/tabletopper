package pages

import (
	"strconv"
	"tabletopper/templ/layouts"
)

const assetTileGrid = "grid-cols-[repeat(auto-fill,minmax(16rem,1fr))]"
const assetFaceGrid = "grid-cols-[repeat(auto-fill,minmax(11rem,1fr))]"
const assetRowGrid = "grid-cols-1"

templ MapAssets(maps []MapAsset) {
	@layouts.Base("Maps | Asset Manager | Tabletopper") {
		@assetsShell(assetTabMaps, mapUploadButton()) {
			@MapCards(maps, "")
		}
	}
}

templ MapCards(maps []MapAsset, query string) {
	@assetCards(mapsGrid(query)) {
		for _, m := range maps {
			@MapCard(m)
		}
	}
}

templ TokenAssets(tokens []LibraryAsset) {
	@layouts.Base("Tokens | Asset Manager | Tabletopper") {
		@assetsShell(assetTabTokens, libraryUploadButton(assetTabTokens, "Upload token")) {
			@TokenCards(tokens, "")
		}
	}
}

templ TokenCards(tokens []LibraryAsset, query string) {
	@assetCards(tokensGrid(query)) {
		for _, t := range tokens {
			@LibraryAssetCard(t)
		}
	}
}

templ AvatarAssets(avatars []LibraryAsset) {
	@layouts.Base("Avatars | Asset Manager | Tabletopper") {
		@assetsShell(assetTabAvatars, libraryUploadButton(assetTabAvatars, "Upload avatar")) {
			@AvatarCards(avatars, "")
		}
	}
}

templ AvatarCards(avatars []LibraryAsset, query string) {
	@assetCards(avatarsGrid(query)) {
		for _, a := range avatars {
			@LibraryAssetCard(a)
		}
	}
}

templ assetsShell(active string, actions templ.Component) {
	<assets-page class="relative block h-screen min-h-dvh w-screen">
		<div class="grid h-full w-full grid-rows-[auto_minmax(0,1fr)]">
			@appBar() {
				<div class={ assetGutter + " flex flex-wrap items-center justify-between gap-4 py-3" }>
					<div class="flex min-w-0 items-center gap-3">
						@backLink(homeBack())
						<h1 class="m-0 font-serif text-[clamp(1.45rem,2.4vw,2.05rem)] leading-none">Asset Manager</h1>
					</div>
					<div class="flex flex-wrap items-center justify-end gap-3 max-[700px]:w-full">
						@assetSearchBox(active)
						if actions != nil {
							@actions
						}
					</div>
				</div>
				@assetTabs(active)
			}
			{ children... }
		</div>
	</assets-page>
}

templ assetSearchBox(kind string) {
	<input
		type="search"
		name="q"
		class="input w-56 max-[700px]:w-full"
		placeholder={ assetSearchLabel(kind) }
		aria-label={ assetSearchLabel(kind) }
		aria-controls={ kind }
		autocomplete="off"
		maxlength={ strconv.Itoa(AssetNameLimit) }
		hx-get={ "/fragment/assets/list?kind=" + kind }
		hx-trigger="input changed delay:250ms, search"
		hx-target={ "#" + kind }
		hx-swap="outerHTML"
	/>
}

templ assetCards(g assetGrid) {
	<section id={ g.Kind } class={ assetGutter + " grid min-h-0 w-full content-start gap-4 overflow-y-auto py-4 " + g.Cols }>
		{ children... }
		<div class="col-span-full hidden only:block">
			if g.Query == "" {
				@noticePanel(g.EmptyHeading) {
					{ g.EmptyBlurb }
				}
			} else {
				@noticePanel(g.NoMatch) {
					{ noMatchHint }
				}
			}
		</div>
	</section>
}

templ mapUploadButton() {
	<label
		for="map-upload"
		class="btn btn-primary relative"
	>
		@uploadIcon()
		Upload map
		<input
			class="absolute top-0 left-0 h-0 w-0 opacity-0"
			id="map-upload"
			type="file"
			name="map"
			accept={ imageAccept }
			required
			hx-post="/assets/maps"
			hx-swap="afterbegin"
			hx-target="#maps"
			hx-encoding="multipart/form-data"
		/>
	</label>
}

templ MapCard(m MapAsset) {
	<asset-card
		class={ sheetSurface + " mb-auto p-4" }
		if m.Polling() {
			data-quiet
			hx-get={ m.CardURL() }
			hx-trigger="every 2s"
			hx-swap="outerMorph"
		}
	>
		<div class="relative mb-2 flex aspect-square w-full items-center justify-center overflow-hidden rounded bg-base-content/5">
			if m.Usable() {
				<img class="absolute inset-0 h-full w-full object-cover" src={ "/assets/images/" + m.ID + "/preview" } alt=""/>
			} else {
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-10 text-base-content/25 icon icon-tabler icons-tabler-outline icon-tabler-photo"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M15 8h.01"></path><path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z"></path><path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5"></path><path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3"></path></svg>
			}
			if m.Polling() {
				<div class="absolute inset-x-0 bottom-0 flex items-center gap-2 bg-base-100/85 px-2 py-1 text-xs">
					<span class="loading loading-spinner loading-xs"></span>
					Building tiles
				</div>
			}
			if m.Retryable() {
				<div class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 bg-error/90 px-2 py-1 text-xs text-error-content">
					<span class="min-w-0">{ m.TileFailure() }</span>
					<button
						class="btn btn-xs shrink-0"
						hx-post={ "/assets/maps/" + m.ID + "/tiles" }
						hx-target="closest asset-card"
						hx-swap="outerHTML"
					>
						{ m.RetryLabel() }
					</button>
				</div>
			}
		</div>
		@assetNameBox(m.nameBox())
		@assetCardControls(m.controls())
	</asset-card>
}
