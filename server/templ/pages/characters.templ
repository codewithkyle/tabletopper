package pages

import (
	"database/sql"
	"fmt"
	"main/internal/queries"
	"main/internal/session"
	"main/templ/layouts"
	"strings"
	"time"
	"strconv"
)

var charactersSettings layouts.BaseTemplateSettings = layouts.BaseTemplateSettings{
	Title: "Characters | Tabletopper",
}

func characterValueOrFallback(value sql.NullString, fallback string) string {
	if !value.Valid {
		return fallback
	}

	trimmed := strings.TrimSpace(value.String)
	if trimmed == "" {
		return fallback
	}

	return trimmed
}

func characterInitial(name string) string {
	trimmed := strings.TrimSpace(name)
	if trimmed == "" {
		return "?"
	}

	runes := []rune(trimmed)
	if len(runes) == 0 {
		return "?"
	}

	return strings.ToUpper(string(runes[0]))
}

func signedNumber(value int) string {
	if value > 0 {
		return fmt.Sprintf("+%d", value)
	}

	return fmt.Sprintf("%d", value)
}

func formatCharacterSize(value string) string {
	trimmed := strings.TrimSpace(value)
	if trimmed == "" {
		return "Medium"
	}

	runes := []rune(strings.ToLower(trimmed))
	if len(runes) == 0 {
		return "Medium"
	}

	runes[0] = []rune(strings.ToUpper(string(runes[0])))[0]
	return string(runes)
}

func characterSpeedOrFallback(value string) string {
	trimmed := strings.TrimSpace(value)
	if trimmed == "" {
		return "30 ft."
	}

	return trimmed
}

templ Characters(session session.UserSession, characters []queries.GetCharactersRow) {
	{{ charactersSettings.Session = session }}
	{{ charactersSettings.Content = charactersContent(session, characters) }}
	@layouts.Base(charactersSettings)
}

templ Character(character queries.GetCharactersRow) {
	<character-card class="card card-border border-base-300 bg-panel/85 shadow-sm backdrop-blur-sm">
		<div class="card-body gap-4 p-4">
			<div class="flex items-center gap-4">
				if !character.AssetID.IsZero() {
					<div class="relative shrink-0" aria-label="Portrait linked">
						<div class="avatar avatar-placeholder border-2 border-base-300">
							<div class="relative w-14 bg-base-300 text-base-content">
								<span class="font-serif text-xl font-bold">{ characterInitial(character.Name) }</span>
								<img class="absolute inset-0 h-full w-full object-cover select-none" src={ "/assets/images/" + character.AssetID.String() + "?t="+strconv.FormatInt(time.Now().Unix(),10) } alt={ character.Name + " avatar" }/>
							</div>
						</div>
						<label aria-label="Replace character avatar" class="tooltip absolute -top-1.5 -right-1.5 z-10 flex h-6 w-6 cursor-pointer items-center justify-center rounded-full border-2 border-base-300 bg-base-200 shadow-sm" data-tip="Replace avatar" for={ "avatar-" + character.ID.String() }>
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M8 7a1 1 0 0 1 -1 1h-1a1 1 0 0 0 -1 1v9a1 1 0 0 0 1 1h9a1 1 0 0 0 1 -1v-1a1 1 0 0 1 2 0v1a3 3 0 0 1 -3 3h-9a3 3 0 0 1 -3 -3v-9a3 3 0 0 1 3 -3h1a1 1 0 0 1 1 1"></path><path d="M14.596 5.011l4.392 4.392l-6.28 6.303a1 1 0 0 1 -.708 .294h-3a1 1 0 0 1 -1 -1v-3a1 1 0 0 1 .294 -.708zm6.496 -2.103a3.097 3.097 0 0 1 .165 4.203l-.164 .18l-.693 .694l-4.387 -4.387l.695 -.69a3.1 3.1 0 0 1 4.384 0"></path></svg>
							<input
								class="absolute h-0 w-0 opacity-0"
								id={ "avatar-" + character.ID.String() }
								type="file"
								name="avatar"
								accept="image/png, image/jpeg, image/webp"
								required
								hx-post={ "/assets/characters/" + character.ID.String() }
								hx-target="closest character-card"
								hx-swap="outerHTML"
								hx-encoding="multipart/form-data"
							/>
						</label>
					</div>
				} else {
					<div class="relative shrink-0" aria-label="No portrait yet">
						<div class="avatar avatar-placeholder border-2 border-base-300">
							<div class="w-14 bg-base-300 text-base-content">
								<span class="font-serif text-xl font-bold">{ characterInitial(character.Name) }</span>
							</div>
						</div>
						<label aria-label="Upload character avatar" class="tooltip absolute -top-1.5 -right-1.5 z-10 flex h-6 w-6 cursor-pointer items-center justify-center rounded-full border-2 border-base-300 bg-base-200 shadow-sm" data-tip="Upload avatar" for={ "avatar-" + character.ID.String() }>
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M8 7a1 1 0 0 1 -1 1h-1a1 1 0 0 0 -1 1v9a1 1 0 0 0 1 1h9a1 1 0 0 0 1 -1v-1a1 1 0 0 1 2 0v1a3 3 0 0 1 -3 3h-9a3 3 0 0 1 -3 -3v-9a3 3 0 0 1 3 -3h1a1 1 0 0 1 1 1"></path><path d="M14.596 5.011l4.392 4.392l-6.28 6.303a1 1 0 0 1 -.708 .294h-3a1 1 0 0 1 -1 -1v-3a1 1 0 0 1 .294 -.708zm6.496 -2.103a3.097 3.097 0 0 1 .165 4.203l-.164 .18l-.693 .694l-4.387 -4.387l.695 -.69a3.1 3.1 0 0 1 4.384 0"></path></svg>
							<input
								class="absolute h-0 w-0 opacity-0"
								id={ "avatar-" + character.ID.String() }
								type="file"
								name="avatar"
								accept="image/png, image/jpeg, image/webp"
								required
								hx-post={ "/assets/characters/" + character.ID.String() }
								hx-swap="none"
								hx-encoding="multipart/form-data"
							/>
						</label>
					</div>
				}
				<div class="min-w-0">
					<h2 class="card-title font-serif text-xl leading-none">{ character.Name }</h2>
					<p class="mt-1 flex flex-wrap items-center gap-1.5 text-sm font-semibold text-base-content/75">
						<span>Lvl { fmt.Sprintf("%d", character.Level) }</span>
						<span class="text-base-content/40">|</span>
						<span>{ characterValueOrFallback(character.Classes, "Class Unknown") }</span>
					</p>
				</div>
			</div>
			<div class="flex flex-wrap gap-2 capitalize">
				<span class="badge badge-sm">{ characterValueOrFallback(character.Race, "Unknown Lineage") }</span>
				<span class="badge badge-sm">{ characterValueOrFallback(character.Background, "No Background") }</span>
				<span class="badge badge-sm">{ characterValueOrFallback(character.Alignment, "Unaligned") }</span>
				<span class="badge badge-sm">{ formatCharacterSize(character.Size) }</span>
			</div>
			<div class="grid grid-cols-2 gap-4 border-y-2 border-base-300 py-4 pl-1">
				<div class="grid content-start gap-1">
					<span class="text-xs font-semibold tracking-wider uppercase text-base-content/75">Armor Class</span>
					<strong class="text-base leading-tight font-extrabold">{ fmt.Sprintf("%d", character.Ac) }</strong>
				</div>
				<div class="grid content-start gap-1">
					<span class="text-xs font-semibold tracking-wider uppercase text-base-content/75">Hit Points</span>
					<strong class="text-base leading-tight font-extrabold">{ fmt.Sprintf("%d / %d", character.CurrentHp, character.MaxHp) }</strong>
				</div>
				<div class="grid content-start gap-1">
					<span class="text-xs font-semibold tracking-wider uppercase text-base-content/75">Proficiency</span>
					<strong class="text-base leading-tight font-extrabold">{ signedNumber(int(character.ProficiencyBonus)) }</strong>
				</div>
				<div class="grid content-start gap-1">
					<span class="text-xs font-semibold tracking-wider uppercase text-base-content/75">Speed</span>
					<strong class="text-base leading-tight font-extrabold">{ characterSpeedOrFallback(character.Speed) }</strong>
				</div>
			</div>
			<div class="card-actions justify-end">
				<a
					href={ "/characters/" + character.ID.String() + "/edit" }
					class="btn btn-soft max-[700px]:flex-1"
				>Edit</a>
				<button
					hx-confirm={ "You are about to delete your character " + character.Name + ". This action cannot be undone." }
					hx-delete={ "/characters/" + character.ID.String() + "/delete" }
					hx-target="closest character-card"
					hx-swap="delete"
					class="btn btn-soft btn-error max-[700px]:flex-1"
				>Delete</button>
			</div>
		</div>
	</character-card>
}

templ charactersContent(session session.UserSession, characters []queries.GetCharactersRow) {
	<character-selector class="relative block h-screen min-h-dvh w-screen p-4 opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards] max-[700px]:p-2.5">
		<section class="grid h-full min-h-0 w-full content-start gap-4 overflow-auto max-[700px]:p-3">
			<header class="flex flex-wrap items-end justify-between gap-4 border-b-2 border-base-300 px-2 pt-2 pb-3 max-[700px]:items-stretch">
				<h1 class="m-0 mt-0.5 font-serif text-[clamp(1.45rem,2.4vw,2.05rem)] leading-none">Characters</h1>
				<div class="flex flex-row flex-nowrap items-center max-[700px]:w-full">
					<a
						href="/"
						type="button"
						class="btn mr-4 max-[700px]:flex-1"
					>
						Back
					</a>
					<a
						href="/characters/new"
						class="btn btn-primary max-[700px]:flex-1"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user-plus"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"></path><path d="M16 19h6"></path><path d="M19 16v6"></path><path d="M6 21v-2a4 4 0 0 1 4 -4h4"></path></svg>
						New character
					</a>
				</div>
			</header>
			if len(characters) == 0 {
				<div class="card card-border mx-auto mt-[min(14vh,7rem)] border-base-300 bg-panel/85 text-center shadow-sm backdrop-blur-sm">
					<div class="card-body p-8">
						<p class="m-0 font-serif text-2xl">No heroes in your roster yet.</p>
						<p class="m-0 mt-4 text-base-content/75">Create your first character sheet <strong>before</strong> your session.</p>
					</div>
				</div>
			} else {
				<div class="grid grid-cols-2 gap-3.5 max-[700px]:grid-cols-1">
					for _, character := range characters {
						@Character(character)
					}
				</div>
			}
		</section>
	</character-selector>
}
