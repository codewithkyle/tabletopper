package pages
import "tabletopper/internal/events"
templ RoomMembers(data RoomMembersData) {
	<ul
		id="room-members"
		hx-get={ data.Path() }
		hx-trigger={ events.Players + " from:window" }
		hx-sync="this:queue last"
		hx-swap="outerHTML"
		class="menu w-full gap-0.5 p-0"
	>
		for _, m := range data.Members {
			@roomMemberRow(data, m)
		}
		if len(data.Members) == 0 {
			<li class="px-2 py-1 text-xs text-base-content/60">Nobody is here yet.</li>
		}
		if !data.Live {
			<li class="px-2 py-1 text-xs text-base-content/60">Waiting for the connection.</li>
		}
	</ul>
}
templ roomMemberRow(data RoomMembersData, m RoomMember) {
	<li>
		<div class="flex items-center gap-2 px-2 py-1">
			<span
				if m.Connected {
					class="size-2 shrink-0 rounded-full bg-success"
				} else {
					class="size-2 shrink-0 rounded-full bg-base-content/25"
				}
				aria-hidden="true"
			></span>
			<img src={ m.Avatar } alt="" class="size-6 shrink-0 rounded-full object-cover"/>
			<span
				if m.Connected {
					class="min-w-0 flex-1 truncate text-sm"
				} else {
					class="min-w-0 flex-1 truncate text-sm text-base-content/50"
				}
			>
				{ m.Name }
				if m.ShowUsername() {
					<span class="text-xs text-base-content/60">({ m.Username })</span>
				}
			</span>
			if m.IsGM {
				<span class="badge badge-xs badge-neutral shrink-0">GM</span>
			}
			if data.CanKick && !m.IsGM {
				<div class="tooltip tooltip-left shrink-0" data-tip="Remove from the room">
					<button
						type="button"
						class="btn btn-ghost btn-xs px-1 text-base-content/50 hover:text-error"
						aria-label={ "Remove " + m.Name + " from the room" }
						hx-post={ data.KickPath(m) }
						hx-target="#room-members"
						hx-swap="outerHTML"
						hx-confirm={ data.KickPrompt(m) }
						data-confirm-heading="Remove this player?"
						data-confirm-label="Remove"
					>
						@kickIcon()
					</button>
				</div>
			}
		</div>
	</li>
}
