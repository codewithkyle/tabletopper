package pages

const rowInlineCell = "flex h-10 items-center @max-[40rem]/sheet:h-8"

templ rowDelete(action string, label string) {
	<div class="fieldset">
		<span class={ rowInlineCell }>
			<button
				type="button"
				class="btn btn-soft btn-error btn-sm"
				aria-label={ label }
				hx-delete={ action }
				hx-target="closest form"
				hx-swap="delete"
			>
				Delete
			</button>
		</span>
	</div>
}

templ rowHandle(label string) {
	<span class={ rowInlineCell }>
		<button
			type="button"
			data-sort-handle
			class="btn btn-ghost btn-sm btn-square cursor-grab touch-none text-base-content/60 hover:text-base-content active:cursor-grabbing"
			aria-label={ label }
			aria-keyshortcuts="ArrowUp ArrowDown"
		>
			@gripIcon()
		</button>
	</span>
}

templ rowOrderSave(id string, action string) {
	<button id={ id } type="button" hidden hx-post={ action } hx-swap="none" hx-vals="">Save order</button>
}

templ rowDetails(group string) {
	<details
		if group != "" {
			name={ group }
		}
		class="collapse collapse-arrow rounded-field border border-base-300 bg-base-100"
	>
		<summary class="collapse-title py-2 ps-3 text-sm font-semibold text-base-content/75">Details</summary>
		<div class="collapse-content px-3 pb-3">
			{ children... }
		</div>
	</details>
}
