package pages

import "strconv"

const spellInlineCell = "flex h-10 items-center @max-[40rem]/sheet:h-8"

templ SpellRow(characterID string, spell Spell) {
	{{ action := "/characters/" + characterID + "/spells/" + strconv.Itoa(spell.Level) + "/" + spell.ID }}
	{{ panel := SpellRowPanel(spell.ID) }}
	<form
		data-spell-row="true"
		class={ surfaceInset + " @container grid gap-3 p-3" }
		hx-post={ action }
		hx-trigger="input delay:1s"
		hx-target={ "#errors-" + panel }
		hx-swap="outerHTML"
		hx-status:422={ "target:#errors-" + panel + ",swap:outerHTML" }
		{ autosaves... }
	>
		@PanelFormErrors(panel, []string{})
		<div class="grid grid-cols-[minmax(0,1fr)_auto_auto] items-end gap-3 @[38rem]:grid-cols-[minmax(0,1fr)_10rem_auto_auto]">
			<label class="fieldset col-span-full @[38rem]:col-span-1">
				<span class={ "fieldset-legend " + denseLegend }>Spell</span>
				<input
					name="name"
					type="text"
					class={ "input w-full font-medium " + denseInput }
					value={ spell.Name }
					placeholder="Fireball"
				/>
			</label>
			<label class="fieldset">
				<span class={ "fieldset-legend " + denseLegend }>Cast Time</span>
				<input
					name="casting_time"
					type="text"
					class={ "input w-full " + denseInput }
					value={ spell.CastingTime }
					placeholder="Action"
				/>
			</label>
			<label class="fieldset cursor-pointer justify-items-center">
				<span class={ "fieldset-legend " + denseLegend }>Prepared</span>
				<span class={ spellInlineCell }>
					<input
						name="prepared"
						type="checkbox"
						value="1"
						class={ "checkbox " + denseCheckbox }
						checked?={ spell.Prepared }
					/>
				</span>
			</label>
			<div class="fieldset">
				<span class={ spellInlineCell }>
					<button
						type="button"
						class="btn btn-soft btn-error btn-sm"
						aria-label={ "Delete " + spellRowName(spell) }
						hx-delete={ action }
						hx-target="closest form"
						hx-swap="delete"
					>
						Delete
					</button>
				</span>
			</div>
		</div>
		<details name="spell-details" class="collapse collapse-arrow rounded-field border border-base-300 bg-base-100">
			<summary class="collapse-title py-2 ps-3 text-sm font-semibold text-base-content/75">Details</summary>
			<div class="collapse-content px-3 pb-3">
				<div class="grid grid-cols-1 gap-3 @[38rem]:grid-cols-3">
					<label class="fieldset">
						<span class={ "fieldset-legend " + denseLegend }>School</span>
						<select name="school" class={ "select w-full " + denseSelect }>
							for _, school := range spellSchools {
								<option value={ school } selected?={ school == spell.School }>{ school }</option>
							}
						</select>
					</label>
					<label class="fieldset">
						<span class={ "fieldset-legend " + denseLegend }>Range</span>
						<input
							name="casting_range"
							type="text"
							class={ "input w-full " + denseInput }
							value={ spell.CastingRange }
							placeholder="150 feet"
						/>
					</label>
					<label class="fieldset">
						<span class={ "fieldset-legend " + denseLegend }>Duration</span>
						<input
							name="duration"
							type="text"
							class={ "input w-full " + denseInput }
							value={ spell.Duration }
							placeholder="Instantaneous"
						/>
					</label>
					<div class="@[38rem]:col-span-full">
						<label class="fieldset">
							<span class={ "fieldset-legend " + denseLegend }>Components</span>
							<input
								name="components"
								type="text"
								class={ "input w-full " + denseInput }
								value={ spell.Components }
								placeholder="V, S, M (a bit of sponge)"
							/>
						</label>
					</div>
					<div class="@[38rem]:col-span-full">
						<label class="fieldset">
							<span class={ "fieldset-legend " + denseLegend }>Spell Text</span>
							<textarea
								name="description"
								class={ "textarea w-full " + denseTextarea }
								rows="5"
								placeholder="What it does, and anything worth reading mid-session."
							>{ spell.Description }</textarea>
						</label>
					</div>
				</div>
			</div>
		</details>
	</form>
}
