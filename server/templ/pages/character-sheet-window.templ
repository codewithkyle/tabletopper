package pages

templ CharacterSheetWindow(data SheetWindowData) {
	<div id={ SheetBodyID } class="@container/sheet grid content-start gap-3" data-window-path={ data.Path() }>
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
			@characterBarFigure("", data.Sheet.Header, false)
			@characterBarChips(data.Sheet.Header, false)
		</div>
		@sheetTabs(data)
		<div class="@container/window grid content-start gap-3">
			switch data.Section {
				case SheetSectionInventory:
					@inventorySection(data.Inventory)
				case SheetSectionAttacks:
					@attackAddButton(data.Sheet.CharacterID, "btn btn-primary btn-sm")
					@sheetSection(data.Sheet, SheetSectionAttacks)
				case SheetSectionSpells:
					@sheetLevels(data)
					if data.Level == SpellsPrepared {
						@sheetSection(data.Sheet, SheetSectionSpells)
					} else {
						@spellAddButton(data.Spells.CharacterID, data.Spells.Level, "btn btn-primary btn-sm")
						@spellsSection(data.Spells)
					}
				default:
					@sheetSection(data.Sheet, data.Section)
			}
		</div>
	</div>
}

templ sheetTabs(data SheetWindowData) {
	<div class="overflow-x-auto">
		<nav class="flex w-max min-w-full gap-1 border-b border-base-300" aria-label="Character sheet sections">
			for _, tab := range SheetTabs() {
				@sheetTab(data.SectionPath(tab.Section), tab.Label, data.Section == tab.Section)
			}
		</nav>
	</div>
}

templ sheetTab(path string, name string, current bool) {
	if current {
		<button type="button" aria-current="page" class={ tabActive } hx-get={ path } hx-target={ "#" + SheetBodyID } hx-swap="outerHTML">{ name }</button>
	} else {
		<button type="button" class={ tabIdle } hx-get={ path } hx-target={ "#" + SheetBodyID } hx-swap="outerHTML">{ name }</button>
	}
}

templ sheetLevels(data SheetWindowData) {
	<div class="overflow-x-auto">
		<nav class="flex w-max min-w-full gap-1" aria-label="Spell levels">
			for _, level := range spellLevelChoices() {
				@sheetLevelTab(data.LevelPath(level), SpellLevelTab(level), data.Level == level)
			}
		</nav>
	</div>
}

templ sheetLevelTab(path string, name string, current bool) {
	if current {
		<button type="button" aria-current="page" class={ levelActive } hx-get={ path } hx-target={ "#" + SheetBodyID } hx-swap="outerHTML">{ name }</button>
	} else {
		<button type="button" class={ levelIdle } hx-get={ path } hx-target={ "#" + SheetBodyID } hx-swap="outerHTML">{ name }</button>
	}
}
