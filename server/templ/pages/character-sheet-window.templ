package pages

templ CharacterSheetWindow(data SheetWindowData) {
	<div id={ SheetBodyID } class="@container/sheet grid content-start gap-3" data-window-path={ data.Path() }>
		@sheetWindowHeader(data.Sheet.Header)
		@windowNav(SheetBodyID, data.Section, data.SectionPath, data.Level, data.LevelPath)
		<div class="@container/window grid content-start gap-3">
			switch data.Section {
				case SheetSectionInventory:
					@inventorySection(data.Inventory)
				case SheetSectionAttacks:
					@attackAddButton(data.Sheet.CharacterID, "btn btn-primary btn-sm")
					@sheetSection(data.Sheet, SheetSectionAttacks)
				case SheetSectionSpells:
					if data.Level == SpellsPrepared {
						@sheetSection(data.Sheet, SheetSectionSpells)
					} else {
						@spellAddButton(data.Spells.CharacterID, data.Spells.Level, "btn btn-primary btn-sm")
						@spellsSection(data.Spells)
					}
				default:
					@sheetSection(data.Sheet, data.Section)
			}
		</div>
	</div>
}

templ sheetWindowHeader(header CharacterHeader) {
	<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
		@characterBarFigure("", header, false)
		@characterBarChips(header, false)
	</div>
}

templ windowNav(body string, section string, sectionPath func(string) string, level int, levelPath func(int) string) {
	<div class="sticky top-0 z-10 min-w-0 bg-panel/85 backdrop-blur-sm">
		@windowTabs(body, section, sectionPath)
		if section == SheetSectionSpells {
			<div class="border-b border-base-300 py-2">
				@windowLevels(body, level, levelPath)
			</div>
		}
	</div>
}

templ windowTabs(body string, current string, path func(string) string) {
	<div class="overflow-x-auto">
		<nav class="flex w-max min-w-full gap-1 border-b border-base-300" aria-label="Character sheet sections">
			for _, tab := range SheetTabs() {
				@sheetTab(body, path(tab.Section), tab.Label, current == tab.Section)
			}
		</nav>
	</div>
}

templ sheetTab(body string, path string, name string, current bool) {
	if current {
		<button type="button" aria-current="page" class={ tabActive } hx-get={ path } hx-target={ "#" + body } hx-swap="outerHTML">{ name }</button>
	} else {
		<button type="button" class={ tabIdle } hx-get={ path } hx-target={ "#" + body } hx-swap="outerHTML">{ name }</button>
	}
}

templ windowLevels(body string, current int, path func(int) string) {
	<div class="overflow-x-auto">
		<nav class="flex w-max min-w-full gap-1" aria-label="Spell levels">
			for _, level := range spellLevelChoices() {
				@sheetLevelTab(body, path(level), SpellLevelTab(level), current == level)
			}
		</nav>
	</div>
}

templ sheetLevelTab(body string, path string, name string, current bool) {
	if current {
		<button type="button" aria-current="page" class={ levelActive } hx-get={ path } hx-target={ "#" + body } hx-swap="outerHTML">{ name }</button>
	} else {
		<button type="button" class={ levelIdle } hx-get={ path } hx-target={ "#" + body } hx-swap="outerHTML">{ name }</button>
	}
}
