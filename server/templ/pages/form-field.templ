package pages

import "strconv"

templ textField(name string, label string, value string, placeholder string, required bool) {
	<div class="fieldset">
		<label class="fieldset-legend" for={ name }>{ label }</label>
		<input
			id={ name }
			name={ name }
			type="text"
			class="input validator peer w-full"
			value={ value }
			if placeholder != "" {
				placeholder={ placeholder }
			}
			required?={ required }
		/>
		if required {
			<p class="validator-hint hidden peer-user-invalid:block text-hint">This field is required.</p>
		}
	</div>
}

templ numberField(name string, label string, value string, required bool) {
	<div class="fieldset">
		<label class="fieldset-legend" for={ name }>{ label }</label>
		<input
			id={ name }
			name={ name }
			type="number"
			inputmode="numeric"
			class="input validator peer w-full"
			value={ value }
			min="0"
			max="9999"
			step="1"
			required?={ required }
		/>
		<p class="validator-hint hidden peer-user-invalid:block text-hint">Enter a number from 0 to 9999.</p>
	</div>
}

templ selectField(name string, label string, options []Option, value string, required bool) {
	<div class="fieldset">
		<label class="fieldset-legend" for={ name }>{ label }</label>
		<select
			id={ name }
			name={ name }
			class="select w-full"
			required?={ required }
		>
			for _, option := range options {
				<option value={ option.Value } selected?={ option.Value == value }>{ option.Label }</option>
			}
		</select>
	</div>
}

templ proseField(name string, label string, value string, placeholder string) {
	<div class="fieldset">
		<label class="fieldset-legend" for={ name }>{ label }</label>
		<textarea
			id={ name }
			name={ name }
			class="textarea w-full"
			rows="4"
			maxlength="1024"
			if placeholder != "" {
				placeholder={ placeholder }
			}
		>{ value }</textarea>
	</div>
}

templ wordField(name string, label string, value string, placeholder string) {
	<div class="fieldset">
		<label class="fieldset-legend" for={ name }>{ label }</label>
		<input
			id={ name }
			name={ name }
			type="text"
			class="input w-full"
			value={ value }
			maxlength="64"
			if placeholder != "" {
				placeholder={ placeholder }
			}
		/>
	</div>
}

templ countField(name string, label string, value string, max int) {
	<div class="fieldset">
		<label class="fieldset-legend" for={ name }>{ label }</label>
		<input
			id={ name }
			name={ name }
			type="number"
			inputmode="numeric"
			class="input validator peer w-full"
			value={ value }
			min="0"
			max={ strconv.Itoa(max) }
			step="1"
		/>
		<p class="validator-hint hidden peer-user-invalid:block text-hint">Enter a number from 0 to { strconv.Itoa(max) }.</p>
	</div>
}

templ deathSaveField(name string, label string, ticked int) {
	<div class="fieldset">
		<span class="fieldset-legend">{ label }</span>
		<div class="flex items-center gap-3 py-2">
			for i := 0; i < DeathSaveLimit; i++ {
				<input
					name={ name }
					type="checkbox"
					value="1"
					class="checkbox"
					aria-label={ label + " " + strconv.Itoa(i+1) }
					checked?={ i < ticked }
				/>
			}
		</div>
	</div>
}

templ toggleField(name string, label string, checked bool) {
	<div class="fieldset">
		<span class="fieldset-legend">{ label }</span>
		<div class="flex items-center py-2">
			<input
				name={ name }
				type="checkbox"
				value="1"
				class="checkbox"
				aria-label={ label }
				checked?={ checked }
			/>
		</div>
	</div>
}

templ abilityField(name string, label string, value string, modifier string) {
	<div class="fieldset">
		<label class="fieldset-legend" for={ name }>{ label }</label>
		<div class="flex items-center gap-2">
			<input
				id={ name }
				name={ name }
				type="number"
				inputmode="numeric"
				class="input validator peer w-full"
				value={ value }
				min="0"
				max="9999"
				step="1"
				required
			/>
			@derivedValue("mod-"+name, modifier, false)
		</div>
		<p class="validator-hint hidden peer-user-invalid:block text-hint">Enter a number from 0 to 9999.</p>
	</div>
}

templ signedNumberField(name string, label string, value string) {
	<div class="fieldset">
		<label class="fieldset-legend" for={ name }>{ label }</label>
		<input
			id={ name }
			name={ name }
			type="number"
			inputmode="numeric"
			class="input w-full"
			value={ value }
			step="1"
		/>
	</div>
}
