package pages

import "strconv"

templ pawnEditor(data RoomPawnData) {
	<form
		id={ data.FormID() }
		class="flex flex-col gap-1.5"
		hx-post={ data.SavePath() }
		hx-trigger={ pawnSaveTrigger }
		hx-target={ "#errors-" + data.Panel() }
		hx-swap="outerHTML"
		hx-sync="this:queue last"
		hx-status:422={ "target:#errors-" + data.Panel() + ",swap:outerHTML" }
	>
		if data.IsGM {
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
				if len(data.Layers) > 1 {
					@pawnLayerSelect(data)
				}
				@pawnVisibleSwitch(data)
			</div>
		}
		if data.Pawn.Object {
			<div class="grid grid-cols-1 gap-1.5 @2xs:grid-cols-2">
				@pawnPixels(data.Field("width"), "width", "Width", data.Pawn.Width)
				@pawnPixels(data.Field("height"), "height", "Height", data.Pawn.Height)
			</div>
			<div class="grid grid-cols-1 gap-1.5 @2xs:grid-cols-2">
				@pawnDegrees(data.Field("rotation"), data.Pawn.Rotation)
				@pawnNumberField(data.Field("ac"), "ac", "Armour class", data.Pawn.AC)
			</div>
		} else {
			<div class="grid grid-cols-1 gap-1.5 @2xs:grid-cols-2">
				@pawnSizeField(data.Field("size"), data.Pawn.SizeValue)
				@pawnNumberField(data.Field("ac"), "ac", "Armour class", data.Pawn.AC)
			</div>
		}
		if !data.Pawn.Object {
			@pawnConditionsEditor(data)
		}
	</form>
}

templ RoomPawnRename(data RoomPawnRenameData) {
	<div class="grid gap-4">
		<h3 class="m-0 pr-10 font-serif text-xl leading-none">Rename</h3>
		<form
			class="grid gap-4"
			hx-post={ data.SavePath() }
			hx-target={ "#errors-" + RoomPawnRenamePanel }
			hx-swap="outerHTML"
			hx-status:422={ "target:#errors-" + RoomPawnRenamePanel + ",swap:outerHTML" }
		>
			@PanelFormErrors(RoomPawnRenamePanel, []string{})
			@textField("name", "Name", data.Name, "", true)
			<div class="modal-action">
				<button
					type="button"
					class="btn border-base-content/50"
					hx-on:click="window.dispatchEvent(new CustomEvent('modal:close'))"
				>Close</button>
				<button type="submit" class="btn btn-primary">Rename</button>
			</div>
		</form>
	</div>
}

templ pawnField(id string, caption string) {
	<label class="flex min-w-0 flex-col gap-0.5" for={ id }>
		<span class="text-[10px] text-base-content/60">{ caption }</span>
		{ children... }
	</label>
}

templ pawnNumberField(id string, name string, caption string, value string) {
	@pawnField(id, caption) {
		<input
			id={ id }
			name={ name }
			type="number"
			inputmode="numeric"
			class="input input-xs validator peer w-full"
			value={ value }
			min="0"
			max="9999"
			step="1"
		/>
		<span class="validator-hint hidden text-[10px] peer-user-invalid:block">Enter a number from 0 to 9999.</span>
	}
}

templ pawnSizeField(id string, value string) {
	@pawnField(id, "Size") {
		<select id={ id } name="size" class="select select-xs w-full" required>
			for _, option := range sizeOptions {
				<option value={ option.Value } selected?={ option.Value == value }>{ option.Label }</option>
			}
		</select>
	}
}

templ pawnPixels(id string, name string, caption string, value string) {
	@pawnField(id, caption) {
		<input
			id={ id }
			name={ name }
			type="number"
			inputmode="numeric"
			class="input input-xs validator peer w-full"
			value={ value }
			min="1"
			max={ strconv.Itoa(ObjectPixelsMax) }
			step="1"
			required
		/>
		<span class="validator-hint hidden text-[10px] peer-user-invalid:block">Enter a whole number of pixels.</span>
	}
}

templ pawnDegrees(id string, value string) {
	@pawnField(id, "Angle") {
		<input
			id={ id }
			name="rotation"
			type="number"
			inputmode="numeric"
			class="input input-xs validator peer w-full"
			value={ value }
			min="0"
			max="359"
			step="1"
			required
		/>
		<span class="validator-hint hidden text-[10px] peer-user-invalid:block">Enter degrees clockwise, 0 to 359.</span>
	}
}

templ pawnVisibleSwitch(data RoomPawnData) {
	<label class="flex shrink-0 items-center gap-1.5">
		<input
			type="checkbox"
			name="shown"
			value="on"
			checked?={ data.Shown }
			aria-label={ data.VisibleLabel() }
			class="toggle toggle-xs peer shrink-0 checked:text-success"
		/>
		<span class="text-[10px] text-warning peer-checked:hidden">Hidden</span>
		<span class="hidden text-[10px] text-base-content/60 peer-checked:inline">Visible</span>
	</label>
}

templ pawnLayerSelect(data RoomPawnData) {
	<label class="flex min-w-0 flex-1 items-center gap-1.5" for={ data.Field("layer") }>
		<span class="shrink-0 text-[10px] text-base-content/60">Floor</span>
		<select id={ data.Field("layer") } name="layer" class="select select-xs min-w-0 flex-1">
			for _, l := range data.Layers {
				<option value={ l.ID } selected?={ l.ID == data.LayerID }>{ l.Name }</option>
			}
		</select>
	</label>
}

templ pawnConditionsEditor(data RoomPawnData) {
	<div class="flex flex-col gap-1">
		<span class="text-[10px] text-base-content/60">Conditions</span>
		<div id={ data.ConditionsID() } class="flex flex-col gap-1">
			for _, c := range data.Pawn.Conditions {
				@RoomPawnConditionRow(data.Pawn.ID, c)
			}
		</div>
		<button
			type="button"
			class="btn btn-xs self-start border-base-content/50"
			hx-get={ data.ConditionRowPath() }
			hx-target={ "#" + data.ConditionsID() }
			hx-swap="beforeend"
		>Add condition</button>
	</div>
	<datalist id={ data.NamesID() }>
		for _, name := range ConditionNames {
			<option value={ name }></option>
		}
	</datalist>
}

templ RoomPawnConditionRow(pawnID string, c RoomPawnCondition) {
	<div data-condition-row class="flex flex-col gap-1 @sm:flex-row @sm:items-center">
		<input type="hidden" name="conditionId" value={ c.ID }/>
		<input
			type="text"
			name="conditionName"
			value={ c.Name }
			{ conditionNameList(pawnID)... }
			placeholder="Condition"
			maxlength="64"
			autocomplete="off"
			aria-label="Condition"
			class="input input-xs min-w-0 @sm:flex-1"
		/>
		<div class="flex min-w-0 items-center gap-1 @sm:shrink-0">
			<select name="conditionColor" aria-label="Colour" class="select select-xs min-w-0 flex-1 @sm:w-20 @sm:flex-none">
				for _, color := range ConditionColors {
					<option value={ color } selected?={ color == c.Color }>{ ConditionColorLabel(color) }</option>
				}
			</select>
			<input
				type="number"
				name="conditionDuration"
				value={ c.Duration }
				min="-1"
				max="999"
				step="1"
				aria-label="Turns, or -1 until removed"
				class="input input-xs w-12 shrink-0"
			/>
			<select name="conditionClear" aria-label="Counts down at" class="select select-xs min-w-0 flex-1 @sm:w-24 @sm:flex-none">
				for _, option := range ConditionClears {
					<option value={ option.Value } selected?={ option.Value == c.Clear }>{ option.Label }</option>
				}
			</select>
			<div class="tooltip tooltip-left shrink-0" data-tip="Remove condition">
				<button
					type="button"
					class="btn btn-ghost btn-xs px-1 text-base-content/50 hover:text-error"
					aria-label="Remove condition"
					data-remove-closest="[data-condition-row]"
				>
					@trashLineIcon()
				</button>
			</div>
		</div>
	</div>
}
