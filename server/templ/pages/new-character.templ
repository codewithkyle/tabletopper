package pages

import (
	"main/internal/session"
	"main/templ/layouts"
)

var newCharacterSettings layouts.BaseTemplateSettings = layouts.BaseTemplateSettings{
	Title: "Character Editor | Tabletopper",
}

templ NewCharacter(session session.UserSession) {
	{{ newCharacterSettings.Session = session }}
	{{ newCharacterSettings.Content = newCharacterContent(session) }}
	@layouts.Base(newCharacterSettings)
}

templ NewCharacterFormErrors(messages []string) {
	if len(messages) > 0 {
		<div id="new-character-form-errors" class="w-full p-8">
			<div class="p-8 rounded-lg border border-solid border-rose-400 text-rose-700 dark:text-rose-400">
				<p class="font-semibold mb-4">Could not save character:</p>
				<ul class="pl-4">
					for _, message := range messages {
						<li>&#8226; { message }</li>
					}
				</ul>
			</div>
		</div>
	} else {
		<div id="new-character-form-errors"></div>
	}
}

templ newCharacterContent(session session.UserSession) {
	<character-editor class="relative block h-screen min-h-dvh w-screen px-4 pt-4 opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]">
		<form class="grid h-full w-full grid-rows-[auto_minmax(0,1fr)] gap-3" hx-post="/characters" hx-status:422="target:#new-character-form-errors" hx-swap="outerHTML">
			<div class="flex flex-wrap items-end justify-between gap-3 p-2 max-[640px]:items-stretch">
				<div>
					<h1 class="mt-0.5 mb-0 font-serif text-[2rem] leading-tight">New Character</h1>
				</div>
				<div class="flex items-center gap-4 max-[640px]:w-full">
					<a
						href="/characters"
						type="button"
						class="btn max-[640px]:flex-1"
					>
						Back
					</a>
					<button
						type="submit"
						class="btn btn-success max-[640px]:flex-1"
					>
						Save character
					</button>
				</div>
			</div>
			<div class="min-h-0 overflow-hidden">
				@NewCharacterFormErrors([]string{})
				<div class="grid h-full gap-4 overflow-auto pb-4">
					@sheetSection("Identity") {
						<div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
							<div class="col-span-2 max-[900px]:col-auto">
								<input-component
									data-name="name"
									data-label="Character Name"
									data-required="true"
									data-value=""
								></input-component>
							</div>
							<input-component
								data-name="classes"
								data-label="Class & Level Notes"
								data-required="true"
								data-placeholder="Cleric 3, Fighter 1"
								data-value=""
							></input-component>
							<input-component
								data-name="background"
								data-label="Background"
								data-value=""
							></input-component>
							<input-component
								data-name="race"
								data-label="Species / Race"
								data-required="true"
								data-placeholder="Human"
								data-value=""
							></input-component>
							<select-component
								data-name="alignment"
								data-label="Alignment"
								data-required="true"
								data-options='[{"label":"Unaligned","value":"unaliged"},{"label":"Any Alignment","value":"any alignment"},{"label":"Lawful Good","value":"lawful good"},{"label":"Neutral Good","value":"neutral good"},{"label":"Chaotic Good","value":"chaotic good"},{"label":"Lawful Neutral","value":"lawful neutral"},{"label":"Neutral","value":"neutral"},{"label":"Chaotic Neutral","value":"chaotic neutral"},{"label":"Lawful Evil","value":"lawful evil"},{"label":"Neutral Evil","value":"neutral evil"},{"label":"Chaotic Evil","value":"chaotic evil"},{"label":"Any Neutral Alignment","value":"any neutral alignment"},{"label":"Any Good Alignment","value":"any good alignment"},{"label":"Any Chaotic Alignment","value":"any chaotic alignment"},{"label":"Any Lawful Alignment","value":"any lawful alignment"},{"label":"Any Non-Good Alignment","value":"any non-good alignment"}]'
								data-value="Unaligned"
							></select-component>
							<select-component
								data-name="size"
								data-label="Size"
								data-required="true"
								data-options='[{"label":"Tiny","value":"tiny"},{"label":"Small","value":"small"},{"label":"Medium","value":"medium"},{"label":"Large","value":"large"},{"label":"Huge","value":"huge"},{"label":"Gargantuan","value":"gargantuan"}]'
								data-value="medium"
							></select-component>
						</div>
					}

					@sheetSection("Abilities") {
						<div class="grid grid-cols-6 gap-4 max-[1160px]:grid-cols-3 max-[640px]:grid-cols-2">
							<number-input-component data-name="str" data-label="Strength" data-required="true" data-value="10"></number-input-component>
							<number-input-component data-name="dex" data-label="Dexterity" data-required="true" data-value="10"></number-input-component>
							<number-input-component data-name="con" data-label="Constitution" data-required="true" data-value="10"></number-input-component>
							<number-input-component data-name="int" data-label="Intelligence" data-required="true" data-value="10"></number-input-component>
							<number-input-component data-name="wis" data-label="Wisdom" data-required="true" data-value="10"></number-input-component>
							<number-input-component data-name="cha" data-label="Charisma" data-required="true" data-value="10"></number-input-component>
						</div>
					}

					@sheetSection("Core Stats") {
						<div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
							<number-input-component data-name="xp" data-label="Experience" data-required="true" data-value="0"></number-input-component>
							<input-component data-name="speed" data-label="Speed" data-value="30 ft."></input-component>
							<number-input-component data-name="ac" data-label="Armor Class" data-required="true" data-value="10"></number-input-component>
							<number-input-component data-name="initiative_bonus" data-label="Initiative Bonus" data-required="true" data-value="0"></number-input-component>
							<number-input-component data-name="max_hp" data-label="Hit Point Maximum" data-required="true" data-value="1"></number-input-component>
							<number-input-component data-name="current_hp" data-label="Current Hit Points" data-required="true" data-value="1"></number-input-component>
							<number-input-component data-name="temp_hp" data-label="Temporary Hit Points" data-required="true" data-value="0"></number-input-component>
							<number-input-component data-name="spell_save_dc" data-label="Spell Save DC" data-required="true" data-value="10"></number-input-component>
							<number-input-component data-name="spell_atk_bonus" data-label="Spell Attack Bonus" data-required="true" data-value="0"></number-input-component>
						</div>
					}

					@sheetSection("Proficiencies & Training") {
						<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
							<input-component data-name="languages" data-label="Languages" data-value="Common"></input-component>
							<input-component
								data-name="proficiencies"
								data-label="Other Proficiencies"
								data-required="true"
								data-placeholder="Medium armor, thieves tools"
								data-value=""
							></input-component>
						</div>
					}

					<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
						<div class="grid content-start gap-4">
							@sheetSection("Saving Throws") {
								<saving-throws-table data-name="saving_throws" data-label="" data-values="{}"></saving-throws-table>
							}
							@sheetSection("Skills") {
								<skills-table data-name="skills" data-label="" data-values="{}"></skills-table>
							}
						</div>
						<div class="grid content-start gap-4">
							@sheetSection("Features & Traits") {
								<monster-info-table
									data-name="features"
									data-label=""
									data-add-label="Add Feature or Trait"
									data-rows="[]"
								></monster-info-table>
							}
							@sheetSection("Equipment") {
								<monster-info-table
									data-name="weapons"
									data-label=""
									data-add-label="Add Equipment"
									data-rows="[]"
								></monster-info-table>
							}
						</div>
					</div>

					@sheetSection("Resources") {
						<monster-info-table
							data-name="resources"
							data-label=""
							data-add-label="Add Resource"
							data-rows="[]"
						></monster-info-table>
					}

					@sheetSection("Spellcasting") {
						<spell-slots-table
							data-name="spells"
							data-label=""
							data-add-label="Add Spell"
							data-levels="{}"
						></spell-slots-table>
					}
				</div>
			</div>
		</form>
	</character-editor>
}
