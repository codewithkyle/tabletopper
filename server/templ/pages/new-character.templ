package pages

import (
	"main/internal/session"
	"main/templ/layouts"
)

var newCharacterSettings layouts.BaseTemplateSettings = layouts.BaseTemplateSettings{
	Title: "Character Editor | Tabletopper",
}

templ NewCharacter(session session.UserSession) {
	{{ newCharacterSettings.Session = session }}
	{{ newCharacterSettings.Content = newCharacterContent(session) }}
	@layouts.Base(newCharacterSettings)
}

templ NewCharacterFormErrors(messages []string) {
	if len(messages) > 0 {
		<div id="new-character-form-errors" class="w-full p-8">
			<div class="p-8 rounded-lg border border-solid border-rose-400 text-rose-700 dark:text-rose-400">
				<p class="font-semibold mb-4">Could not save character:</p>
				<ul class="pl-4">
					for _, message := range messages {
						<li>&#8226; { message }</li>
					}
				</ul>
			</div>
		</div>
	} else {
		<div id="new-character-form-errors"></div>
	}
}

templ newCharacterContent(session session.UserSession) {
	<character-editor class="relative block h-screen min-h-dvh w-screen px-4 pt-4 opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]">
		<form class="grid h-full w-full grid-rows-[auto_minmax(0,1fr)] gap-3" hx-post="/characters" hx-status:422="target:#new-character-form-errors" hx-swap="outerHTML">
			<div class="flex flex-wrap items-end justify-between gap-3 p-2 max-[640px]:items-stretch">
				<div>
					<h1 class="mt-0.5 mb-0 font-serif text-[2rem] leading-tight">New Character</h1>
				</div>
				<div class="flex items-center gap-4 max-[640px]:w-full">
					<a
						href="/characters"
						type="button"
						class="btn max-[640px]:flex-1"
					>
						Back
					</a>
					<button
						type="submit"
						class="btn btn-success max-[640px]:flex-1"
					>
						Save character
					</button>
				</div>
			</div>
			<div class="min-h-0 overflow-hidden">
				@NewCharacterFormErrors([]string{})
				<div class="grid h-full gap-4 overflow-auto pb-4">
					@sheetSection("Identity") {
						<div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
							<div class="col-span-2 max-[900px]:col-auto">
								@textField("name", "Character Name", "", "", true)
							</div>
							@textField("classes", "Class & Level Notes", "", "Cleric 3, Fighter 1", true)
							@textField("background", "Background", "", "", false)
							@textField("race", "Species / Race", "", "Human", true)
							@selectField("alignment", "Alignment", alignmentOptions, defaultAlignment, true)
							@selectField("size", "Size", sizeOptions, defaultSize, true)
						</div>
					}

					@sheetSection("Abilities") {
						<div class="grid grid-cols-6 gap-4 max-[1160px]:grid-cols-3 max-[640px]:grid-cols-2">
							@numberField("str", "Strength", "10", true)
							@numberField("dex", "Dexterity", "10", true)
							@numberField("con", "Constitution", "10", true)
							@numberField("int", "Intelligence", "10", true)
							@numberField("wis", "Wisdom", "10", true)
							@numberField("cha", "Charisma", "10", true)
						</div>
					}

					@sheetSection("Core Stats") {
						<div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
							@numberField("xp", "Experience", "0", true)
							@textField("speed", "Speed", "30 ft.", "", false)
							@numberField("ac", "Armor Class", "10", true)
							@numberField("initiative_bonus", "Initiative Bonus", "0", true)
							@numberField("max_hp", "Hit Point Maximum", "1", true)
							@numberField("current_hp", "Current Hit Points", "1", true)
							@numberField("temp_hp", "Temporary Hit Points", "0", true)
							@numberField("spell_save_dc", "Spell Save DC", "10", true)
							@numberField("spell_atk_bonus", "Spell Attack Bonus", "0", true)
						</div>
					}

					@sheetSection("Proficiencies & Training") {
						<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
							@textField("languages", "Languages", "Common", "", false)
							@textField("proficiencies", "Other Proficiencies", "", "Medium armor, thieves tools", true)
						</div>
					}

					<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
						<div class="grid content-start gap-4">
							@sheetSection("Saving Throws") {
								<saving-throws-table data-name="saving_throws" data-label="" data-values="{}"></saving-throws-table>
							}
							@sheetSection("Skills") {
								<skills-table data-name="skills" data-label="" data-values="{}"></skills-table>
							}
						</div>
						<div class="grid content-start gap-4">
							@sheetSection("Features & Traits") {
								<monster-info-table
									data-name="features"
									data-label=""
									data-add-label="Add Feature or Trait"
									data-rows="[]"
								></monster-info-table>
							}
							@sheetSection("Equipment") {
								<monster-info-table
									data-name="weapons"
									data-label=""
									data-add-label="Add Equipment"
									data-rows="[]"
								></monster-info-table>
							}
						</div>
					</div>

					@sheetSection("Resources") {
						<monster-info-table
							data-name="resources"
							data-label=""
							data-add-label="Add Resource"
							data-rows="[]"
						></monster-info-table>
					}

					@sheetSection("Spellcasting") {
						<spell-slots-table
							data-name="spells"
							data-label=""
							data-add-label="Add Spell"
							data-levels="{}"
						></spell-slots-table>
					}
				</div>
			</div>
		</form>
	</character-editor>
}
