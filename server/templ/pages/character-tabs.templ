package pages

templ characterTabs(characterID string, active string) {
	<div class={ tabScroller }>
		<nav class={ barGutter + " flex w-max min-w-full gap-1" } aria-label="Character sheet sections">
			for _, tab := range SheetTabs() {
				@tabLink(CharacterEditPath(characterID, tab.Section), tab.Label, active == tab.Section)
			}
			@tabLink(CharacterEditPath(characterID, characterTabJournal), "Journal", active == characterTabJournal)
		</nav>
	</div>
}

const characterTabJournal = "journal"
