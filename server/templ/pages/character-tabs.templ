package pages

templ characterTabs(characterID string, active string) {
	{{ base := "/characters/" + characterID + "/edit" }}
	<nav class="flex gap-1 border-b-2 border-base-300 px-2" aria-label="Character sheet sections">
		@characterTabLink(base, "Character", active == characterTabMain)
		@characterTabLink(base+"/inventory", "Inventory", active == characterTabInventory)
		@characterTabLink(base+"/spells/0", "Spells", active == characterTabSpells)
	</nav>
}

const (
	characterTabMain      = "character"
	characterTabInventory = "inventory"
	characterTabSpells    = "spells"
)

templ characterTabLink(href string, name string, current bool) {
	if current {
		<a
			href={ href }
			aria-current="page"
			class="-mb-0.5 border-b-2 border-primary px-4 py-2 font-semibold"
		>{ name }</a>
	} else {
		<a
			href={ href }
			class="-mb-0.5 border-b-2 border-transparent px-4 py-2 font-semibold text-base-content/60 hover:border-base-content/30 hover:text-base-content"
		>{ name }</a>
	}
}
