package pages

templ characterTabs(characterID string, active string) {
	{{ base := "/characters/" + characterID + "/edit" }}
	<nav class={ barGutter + " flex gap-1" } aria-label="Character sheet sections">
		@tabLink(base, "Character", active == characterTabMain)
		@tabLink(base+"/inventory", "Inventory", active == characterTabInventory)
		@tabLink(base+"/spells/0", "Spells", active == characterTabSpells)
		@tabLink(base+"/journal", "Journal", active == characterTabJournal)
	</nav>
}

const (
	characterTabMain      = "character"
	characterTabInventory = "inventory"
	characterTabSpells    = "spells"
	characterTabJournal   = "journal"
)
