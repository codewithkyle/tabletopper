package pages

import (
	"tabletopper/internal/session"
	"tabletopper/templ/layouts"
)

templ Homepage(session session.UserSession) {
	@layouts.Base("Tabletopper", "/js/zone-detect.js") {
		@homepageContent(session)
	}
}

templ homepageContent(session session.UserSession) {
	if session.UserID.IsZero() {
		<home-page class="relative inline-block max-w-full p-8">
			<div class="w-full max-w-[1024px] text-center">
				<h1 class="mb-12 font-[Lobster] text-[10rem] font-bold text-primary opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]">Tabletopper</h1>
				<div class="flex w-full flex-row flex-nowrap items-center justify-center opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]">
					<a
						href="/sign-in"
						class="btn btn-outline btn-lg"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M9 8v-2a2 2 0 0 1 2 -2h7a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-7a2 2 0 0 1 -2 -2v-2"></path><path d="M3 12h13l-3 -3"></path><path d="M13 15l3 -3"></path></svg>
						Log in to contine
					</a>
				</div>
			</div>
			@footer(false)
		</home-page>
	} else {
		<home-page class="relative inline-block inset-0 h-screen w-screen pt-8 pr-16 pl-12">
			<div class="w-full flex flex-row flex-nowrap items-center justify-between">
				<h1 class="font-[Lobster] text-[10rem] font-bold text-primary opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]">Tabletopper</h1>
				<div id="user-badge" class={ surfacePanel + " -mt-4 flex flex-row flex-nowrap items-center rounded-full px-3 py-2 opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]" }>
					<img class="mr-3 size-12 overflow-hidden rounded-full" src={ session.ProfileImageURL }/>
					<p class="inline-block mr-8 text-xs font-medium">
						Welcome
						<br/>
						<span class="mt-1 inline-block text-xl font-bold text-primary">{ session.Username }</span>
					</p>
					<div class="tooltip" data-tip="Logout">
						<a
							href="/logout"
							class="btn btn-ghost btn-lg btn-circle"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M10 8v-2a2 2 0 0 1 2 -2h7a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-7a2 2 0 0 1 -2 -2v-2"></path><path d="M15 12h-12l3 -3"></path><path d="M6 15l-3 -3"></path></svg>
						</a>
					</div>
				</div>
			</div>
			if !session.Onboarded {
				<div hidden data-modal-autoopen="/fragment/account/welcome"></div>
			}
			<nav class="mt-[4vh] inline-block pl-4">
				<a class="[animation-delay:350ms] mb-6 block text-[3.5rem] font-bold transition-colors duration-150 hover:text-primary focus-visible:text-primary opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]" href="/host">Host Game</a>
				<a class="[animation-delay:400ms] mb-6 block text-[3.5rem] font-bold transition-colors duration-150 hover:text-primary focus-visible:text-primary opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]" href="/join">Join Game</a>
				<a class="[animation-delay:450ms] mb-6 block text-[3.5rem] font-bold transition-colors duration-150 hover:text-primary focus-visible:text-primary opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]" href="/characters">Characters</a>
				<a class="[animation-delay:500ms] mb-6 block text-[3.5rem] font-bold transition-colors duration-150 hover:text-primary focus-visible:text-primary opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]" href="/assets/maps">Manage Assets</a>
				<a class="[animation-delay:550ms] mb-6 block text-[3.5rem] font-bold transition-colors duration-150 hover:text-primary focus-visible:text-primary opacity-0 animate-[fadeIn_600ms_300ms_ease-out_forwards]" href="/monsters">Monster Manual</a>
			</nav>
			@footer(true)
		</home-page>
	}
}

templ footer(signedIn bool) {
	<div class="fixed bottom-0 left-1/2 -translate-x-1/2 mb-1">
		if signedIn {
			<div class="tooltip" data-tip="Account Settings">
				<button
					type="button"
					class="btn btn-ghost btn-circle"
					data-modal-open="/fragment/account/settings"
				>
					@settingsIcon()
				</button>
			</div>
		}
		<div class="tooltip" data-tip="Source Code">
			<a
				href="https://github.com/codewithkyle/tabletopper"
				class="btn btn-ghost btn-circle"
				target="_blank"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path></svg>
			</a>
		</div>
		<div class="tooltip" data-tip="Project Roadmap">
			<a
				href="https://github.com/users/codewithkyle/projects/5/views/1"
				class="btn btn-ghost btn-circle"
				target="_blank"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 4l6 0"></path><path d="M14 4l6 0"></path><path d="M4 8m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z"></path><path d="M14 8m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z"></path></svg>
			</a>
		</div>
		<div class="tooltip" data-tip="Terms of Service">
			<a
				href="/tos"
				class="btn btn-ghost btn-circle"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M13 10l7.383 7.418c.823 .82 .823 2.148 0 2.967a2.11 2.11 0 0 1 -2.976 0l-7.407 -7.385"></path><path d="M6 9l4 4"></path><path d="M13 10l-4 -4"></path><path d="M3 21h7"></path><path d="M6.793 15.793l-3.586 -3.586a1 1 0 0 1 0 -1.414l2.293 -2.293l.5 .5l3 -3l-.5 -.5l2.293 -2.293a1 1 0 0 1 1.414 0l3.586 3.586a1 1 0 0 1 0 1.414l-2.293 2.293l-.5 -.5l-3 3l.5 .5l-2.293 2.293a1 1 0 0 1 -1.414 0z"></path></svg>
			</a>
		</div>
		<div class="tooltip" data-tip="Privacy Policy">
			<a
				href="/privacy"
				class="btn btn-ghost btn-circle"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 11h18"></path><path d="M5 11v-4a3 3 0 0 1 3 -3h8a3 3 0 0 1 3 3v4"></path><path d="M7 17m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M17 17m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path d="M10 17h4"></path></svg>
			</a>
		</div>
	</div>
}
