package pages

import "strconv"

type bonusEntry struct {
	Key   string
	Abbr  string
	Label string
}

templ bonusRow(field string, label string, abbr string, value int) {
	<div class="flex items-center justify-between gap-2 rounded-field border-2 border-base-300 p-2">
		<span class="flex min-w-0 flex-col gap-0.5">
			<label class="text-sm font-medium" for={ field }>{ label }</label>
			<span class="text-xs font-semibold tracking-wider text-base-content/75">{ abbr }</span>
		</span>
		<input
			id={ field }
			name={ field }
			type="number"
			inputmode="numeric"
			step="1"
			class="input input-sm w-14 text-right"
			value={ strconv.Itoa(value) }
		/>
	</div>
}
