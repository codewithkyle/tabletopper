package pages

import "strconv"
import "tabletopper/templ/layouts"

templ EditCharacterSpellLevel(data SpellLevelPageData) {
	@layouts.Base(SpellLevelName(data.Level) + " | Tabletopper") {
		@editCharacterShell(data.CharacterID, data.Header, characterTabSpells, shellLayout{
			Actions: spellAddButton(data.CharacterID, data.Level, "btn btn-primary max-[640px]:flex-1"),
			SubNav:  spellLevelTabs(data.CharacterID, data.Level),
		}) {
			@spellsSection(data)
		}
	}
}

templ spellAddButton(characterID string, level int, class string) {
	<button
		type="button"
		class={ class }
		hx-post={ "/characters/" + characterID + "/spells/" + strconv.Itoa(level) }
		hx-target="#spell-rows"
		hx-swap="prepend"
	>
		Add Spell
	</button>
}

templ spellsSection(data SpellLevelPageData) {
	@sheetPanel(SpellLevelName(data.Level)) {
		if data.Level > 0 {
			@spellSlotsForm(data.CharacterID, data.Current) {
				<span class="font-serif text-base leading-none font-bold">Spell slots</span>
			}
		}
		<div id="spell-rows" class="grid gap-3">
			for _, spell := range data.Spells {
				@SpellRow(data.CharacterID, spell)
			}
			<p class="hidden text-base-content/70 only:block">No spells yet. Start one with the Add Spell button above.</p>
		</div>
	}
}
