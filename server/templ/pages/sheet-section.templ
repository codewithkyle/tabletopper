package pages

const surfacePanel = "border border-base-300 bg-panel/85 shadow-panel backdrop-blur-sm"
const surfaceInset = "rounded-field bg-base-content/5"
const sheetSurface = "card " + surfacePanel
const panelTrigger = "input delay:1s, repeater:changed"

templ savingPanel(title string, action string, panel string) {
	<form
		id={ panelFormID(panel) }
		class={ sheetSurface }
		hx-post={ action }
		hx-trigger={ panelTrigger }
		hx-target={ "#errors-" + panel }
		hx-swap="outerHTML"
		hx-status:422={ "target:#errors-" + panel + ",swap:outerHTML" }
	>
		<div class="card-body gap-4 p-4">
			@sheetHeading(title)
			@PanelFormErrors(panel, []string{})
			{ children... }
		</div>
	</form>
}

templ sheetPanel(title string) {
	<div class={ sheetSurface }>
		<div class="card-body gap-4 p-4">
			@sheetHeading(title)
			{ children... }
		</div>
	</div>
}

templ sheetHeading(title string) {
	<header class="flex items-center">
		<h2 class="m-0 font-serif text-[0.82rem] leading-none font-bold tracking-[0.09em] uppercase text-base-content/65">{ title }</h2>
	</header>
}

templ livePanel(live SheetLive, section string) {
	if live.On() {
		<div
			hx-get={ live.Path(section) }
			hx-trigger={ live.Trigger() }
			hx-sync="this:queue last"
			hx-swap="outerHTML"
		>
			{ children... }
		</div>
	} else {
		{ children... }
	}
}
