package pages

const surfacePanel = "border border-base-300 bg-panel/85 shadow-panel backdrop-blur-sm"
const surfaceInset = "rounded-field bg-base-content/5"
const sheetSurface = "card " + surfacePanel
const panelTrigger = "input delay:1s, repeater:changed"
const denseInput = "@max-[40rem]/sheet:input-sm"
const denseSelect = "@max-[40rem]/sheet:select-sm"
const denseTextarea = "@max-[40rem]/sheet:textarea-sm"
const denseCheckbox = "@max-[40rem]/sheet:checkbox-sm"
const denseLegend = "@max-[40rem]/sheet:py-1 @max-[40rem]/sheet:text-xs"
const denseBody = "@max-[40rem]/sheet:gap-3 @max-[40rem]/sheet:p-3"

templ savingPanel(title string, action string, panel string) {
	@panelForm(sheetSurface, "card-body gap-4 p-4 "+denseBody, title, action, panel) {
		{ children... }
	}
}

templ flatSavingPanel(action string, panel string) {
	@panelForm("grid", "grid gap-2", "", action, panel) {
		{ children... }
	}
}

templ panelForm(surface string, body string, title string, action string, panel string) {
	<form
		id={ panelFormID(panel) }
		class={ surface }
		hx-post={ action }
		hx-trigger={ panelTrigger }
		hx-target={ "#errors-" + panel }
		hx-swap="outerHTML"
		hx-status:422={ "target:#errors-" + panel + ",swap:outerHTML" }
		{ autosaves... }
	>
		<div class={ body }>
			if title != "" {
				@sheetHeading(title)
			}
			@PanelFormErrors(panel, []string{})
			{ children... }
		</div>
	</form>
}

templ sheetPanel(title string) {
	<div class={ sheetSurface }>
		<div class={ "card-body gap-4 p-4 " + denseBody }>
			@sheetHeading(title)
			{ children... }
		</div>
	</div>
}

templ sheetHeading(title string) {
	<header class="flex items-center">
		<h2 class="m-0 font-serif text-[0.82rem] leading-none font-bold tracking-[0.09em] uppercase text-base-content/65">{ title }</h2>
	</header>
}

templ livePanel(live SheetLive, section string) {
	if live.On() {
		<div
			hx-get={ live.Path(section) }
			hx-trigger={ live.Trigger() }
			hx-sync="this:queue last"
			hx-swap="outerHTML"
		>
			{ children... }
		</div>
	} else {
		{ children... }
	}
}
