package pages

// sheetSection is the panel the character sheet is built out of -- ten of them
// per page, twice over (new and edit). It was .sheet-section in
// character-sheet.css; as a DaisyUI card the surface is a class string rather
// than a rule, and repeating that string twenty times would be worse than the
// stylesheet was. So it lives here once.
templ sheetSection(title string) {
	<section class="card card-border border-base-300 bg-base-200/85 shadow-sm backdrop-blur-sm">
		<div class="card-body gap-4 p-4">
			<header class="flex items-center border-b-2 border-base-300 pb-2">
				<h2 class="m-0 font-serif text-[0.82rem] leading-none font-bold tracking-[0.09em] uppercase">{ title }</h2>
			</header>
			{ children... }
		</div>
	</section>
}
