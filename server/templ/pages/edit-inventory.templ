package pages

import "tabletopper/templ/layouts"

templ EditCharacterInventory(data InventoryPageData) {
	@layouts.Base("Inventory | Tabletopper") {
		@editCharacterShell(data.CharacterID, data.Header, characterTabInventory, shellLayout{}) {
			@inventorySection(data)
		}
	}
}

templ inventorySection(data InventoryPageData) {
	@sheetPanel("Inventory") {
		<div class="overflow-x-auto">
			<div id="inventory-items" class="list min-w-[28rem]">
				@inventoryHeader()
				for _, item := range data.Items {
					@InventoryRow(data.CharacterID, item)
				}
			</div>
		</div>
		<button
			type="button"
			class="btn btn-soft btn-warning btn-sm"
			hx-post={ "/characters/" + data.CharacterID + "/inventory" }
			hx-target="#inventory-items"
			hx-swap="append"
		>
			Add Item
		</button>
	}
}
