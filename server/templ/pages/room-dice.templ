package pages

import "tabletopper/internal/uievents"

templ RoomDice(data RoomDiceData) {
	<div class="flex flex-col gap-3">
		@roomDiceForm(data)
		@roomDiceLog(data)
	</div>
}

templ roomDiceForm(data RoomDiceData) {
	<form
		class="flex flex-col gap-2"
		hx-post={ data.RollPath() }
		hx-swap="none"
	>
		<div class="join peer w-full">
			<input
				type="text"
				name="expr"
				required
				autocomplete="off"
				spellcheck="false"
				maxlength={ data.ExprLimit() }
				placeholder="1d20 + 5"
				aria-label="Dice to roll"
				class="input input-sm validator join-item w-full font-mono"
				hx-on:input="this.form.querySelector('[data-save-roll]').disabled = !this.value.trim()"
			/>
			<button type="submit" class="btn btn-sm join-item">Roll</button>
			<button
				type="button"
				class="btn btn-sm btn-square join-item"
				data-save-roll={ data.SaveFormPath() }
				aria-label="Save this roll"
				title="Save this roll"
				disabled
				hx-on:click="window.dispatchEvent(new CustomEvent('modal:open', { detail: { url: this.dataset.saveRoll + '&expr=' + encodeURIComponent(this.form.expr.value), size: 'sm' } }))"
			>
				@saveIcon()
			</button>
		</div>
		<p class="validator-hint hidden text-[10px] peer-has-[:user-invalid]:block">Type some dice to roll, such as 1d20 + 5.</p>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<select name="adv" aria-label="How to roll" class="select select-xs w-auto">
				<option value="0" selected>Straight</option>
				<option value="1">Advantage</option>
				<option value="-1">Disadvantage</option>
			</select>
			<label class="flex cursor-pointer items-center gap-1.5 text-xs">
				<input type="checkbox" name="secret" value="1" class="toggle toggle-xs"/>
				Secret
			</label>
		</div>
		<div
			id={ RoomSavedRollsID }
			class="hidden flex-wrap gap-1 has-[[data-saved-roll]]:flex"
			hx-get={ data.Path() }
			hx-trigger={ uievents.SavedRolls + " from:window" }
			hx-select={ "#" + RoomSavedRollsID }
			hx-sync="this:queue last"
			hx-swap="outerHTML"
		>
			for _, saved := range data.Saved {
				@roomSavedRollButton(data.RoomID, saved)
			}
		</div>
	</form>
}

templ roomSavedRollButton(roomID string, saved RoomSavedRoll) {
	<div class="join max-w-full" data-saved-roll={ saved.ID }>
		<button
			type="button"
			class="btn btn-sm join-item min-w-0 shrink flex-nowrap"
			hx-post={ diceRollPath(roomID) }
			hx-vals={ saved.RollVals() }
			hx-swap="none"
		>
			if saved.Label != "" {
				<span class="truncate">{ saved.Label }</span>
				<span class="shrink-0 font-mono font-normal whitespace-nowrap text-base-content/60">{ saved.Expr }</span>
			} else {
				<span class="font-mono whitespace-nowrap">{ saved.Expr }</span>
			}
		</button>
		<button
			type="button"
			class="btn btn-sm btn-square join-item"
			aria-label={ saved.RemoveLabel() }
			hx-delete={ saved.RemovePath() }
			hx-target="closest [data-saved-roll]"
			hx-swap="delete"
		>
			@windowCloseIcon()
		</button>
	</div>
}

templ RoomSaveRoll(data RoomSaveRollData) {
	{{ errorBlock := "#errors-" + SaveRollPanel }}
	<div class="grid gap-4">
		<div class="grid gap-1">
			<h3 class="m-0 font-serif text-xl leading-none">Save roll</h3>
			<p class="m-0 font-mono text-sm text-base-content/70">{ data.Expr }</p>
		</div>
		<form
			class="grid"
			hx-post={ data.SavePath() }
			hx-target={ errorBlock }
			hx-swap="outerHTML"
			hx-status:422={ "target:" + errorBlock + ",swap:outerHTML" }
		>
			@PanelFormErrors(SaveRollPanel, data.Problems)
			<input type="hidden" name="expr" value={ data.Expr }/>
			<div class="fieldset">
				<label class="fieldset-legend" for="saved-roll-label">
					Label
					<span class="font-normal text-base-content/60">(optional)</span>
				</label>
				<input
					id="saved-roll-label"
					name="label"
					type="text"
					class="input w-full"
					maxlength={ data.LabelLimit() }
					placeholder="Longsword"
					autocomplete="off"
				/>
			</div>
			<div class="modal-action">
				<button
					type="button"
					class="btn border-base-content/50"
					hx-on:click="window.dispatchEvent(new CustomEvent('modal:close'))"
				>Close</button>
				<button type="submit" class="btn btn-primary" disabled?={ len(data.Problems) > 0 }>Save roll</button>
			</div>
		</form>
	</div>
}

templ roomDiceLog(data RoomDiceData) {
	<ul
		id={ RoomDiceLogID }
		class="list"
		hx-get={ data.Path() }
		hx-trigger={ uievents.Rolls + " from:window" }
		hx-select={ data.LogSelect() }
		hx-sync="this:queue last"
		hx-swap="outerHTML"
	>
		for _, r := range data.Rolls {
			@roomDiceRow(r)
		}
		if len(data.Rolls) == 0 {
			<li class="px-1 py-2 text-xs text-base-content/60">Nothing has been rolled yet.</li>
		}
	</ul>
}

templ roomDiceRow(r RoomDiceRoll) {
	<li class="list-row px-1 py-2">
		<div class="list-col-grow min-w-0">
			<div class="flex flex-wrap items-center gap-1">
				<span class="truncate text-sm font-medium">{ r.Who }</span>
				if r.Label != "" {
					<span class="badge badge-xs badge-neutral">{ r.Label }</span>
				}
				if r.AdvLabel() != "" {
					<span class="badge badge-xs badge-ghost">{ r.AdvLabel() }</span>
				}
				if r.Secret {
					<span class="badge badge-xs badge-ghost">Secret</span>
				}
			</div>
			<div class="flex flex-wrap items-baseline gap-x-1.5 text-xs text-base-content/60">
				<span class="font-mono">{ r.Expr }</span>
				<span aria-hidden="true">&rarr;</span>
				for _, d := range r.Dice {
					if d.Kept {
						<span class="font-mono text-base-content/80">{ d.Text() }</span>
					} else {
						<span class="font-mono text-base-content/30 line-through">{ d.Text() }</span>
					}
				}
				if r.ModText() != "" {
					<span class="font-mono">{ r.ModText() }</span>
				}
			</div>
		</div>
		if r.Crit {
			<span class="shrink-0 self-center text-lg leading-none font-semibold tabular-nums text-success">{ r.TotalText() }</span>
		} else if r.Fumble {
			<span class="shrink-0 self-center text-lg leading-none font-semibold tabular-nums text-error">{ r.TotalText() }</span>
		} else {
			<span class="shrink-0 self-center text-lg leading-none font-semibold tabular-nums">{ r.TotalText() }</span>
		}
	</li>
}
