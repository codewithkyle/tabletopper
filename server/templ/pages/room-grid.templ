package pages

import "tabletopper/internal/uievents"

templ RoomGrid(data RoomGridData) {
	<div
		hx-get={ data.Path() }
		hx-trigger={ uievents.Resync + " from:window" }
		hx-sync="this:queue last"
		hx-swap="outerHTML"
	>
		<form
			id="room-grid"
			class="group flex flex-col gap-3"
			hx-post={ data.SavePath() }
			hx-trigger="change"
			hx-sync="this:queue last"
			hx-target={ "#errors-" + RoomGridPanel }
			hx-swap="outerHTML"
			hx-status:422={ "target:#errors-" + RoomGridPanel + ",swap:outerHTML" }
			{ autosaves... }
		>
			@PanelFormErrors(RoomGridPanel, data.Errors)
			@panelRadios("gridType", "Grid type", GridTypeChoices(), data.Type)
			@panelRadios("gridLines", "Grid lines", GridLineChoices(), data.Lines)
			<div class="grid grid-cols-2 gap-2">
				@gridNumber("cellSize", "Cell size", data.CellSizeText(), GridCellMin, GridCellMax)
				@gridDistance(data)
				@gridNumber("offsetX", "Offset across", data.OffsetXText(), "", "")
				@gridNumber("offsetY", "Offset down", data.OffsetYText(), "", "")
			</div>
			@gridColor(data)
			@panelRadios("snap", "Snapping", GridSnapChoices(), data.Snap)
			<div class="group-has-[input[value^=hex]:checked]:hidden">
				@panelRadios("diagonals", "Diagonals", GridDiagonalChoices(), data.Diagonals)
			</div>
		</form>
	</div>
}

templ gridDistance(data RoomGridData) {
	<div class="flex flex-col gap-0.5">
		<span class="text-[10px] text-base-content/60">Distance per cell</span>
		<div class="flex gap-1">
			<input
				type="number"
				name="feetPerCell"
				value={ data.FeetText() }
				required
				min={ GridFeetMin }
				max={ GridFeetMax }
				aria-label="Distance per cell"
				class="input input-xs w-full min-w-0"
			/>
			<select name="units" aria-label="Units" class="select select-xs w-24 shrink-0">
				for _, c := range GridUnitChoices() {
					<option value={ c.Value } selected?={ c.Value == data.Units }>{ c.Label }</option>
				}
			</select>
		</div>
	</div>
}

templ gridNumber(name string, caption string, value string, min string, max string) {
	<label class="flex flex-col gap-0.5">
		<span class="text-[10px] text-base-content/60">{ caption }</span>
		<input
			type="number"
			name={ name }
			value={ value }
			required
			if min != "" {
				min={ min }
			}
			if max != "" {
				max={ max }
			}
			class="input input-xs w-full"
		/>
	</label>
}

templ gridColor(data RoomGridData) {
	<div data-color class="flex flex-col gap-0.5">
		<span class="text-[10px] text-base-content/60">Colour</span>
		<div class="flex items-center gap-1.5">
			<button
				type="button"
				data-color-open
				aria-expanded="false"
				aria-controls={ GridColorPickerID }
				aria-label="Choose a grid colour"
				class="size-6 shrink-0 cursor-pointer rounded-sm border border-base-300 bg-white p-0.5"
			>
				<span data-color-swatch class="block size-full rounded-xs" style={ data.SwatchStyle() }></span>
			</button>
			<input
				type="text"
				name="color"
				data-color-field
				value={ data.Color }
				required
				pattern={ GridColorPat }
				aria-label="Grid colour, as hex"
				class="input input-xs min-w-0 flex-1 font-mono"
			/>
		</div>
		<hex-alpha-color-picker
			id={ GridColorPickerID }
			data-color-picker
			hidden
			color={ data.PickerColor() }
			class="mt-1 h-44 w-full"
		></hex-alpha-color-picker>
	</div>
}
