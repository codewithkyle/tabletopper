package pages

templ RoomGrid(data RoomGridData) {
	<form
		id="room-grid"
		class="flex flex-col gap-3"
		hx-post={ data.SavePath() }
		hx-trigger="change"
		hx-sync="this:queue last"
		hx-target={ "#errors-" + RoomGridPanel }
		hx-swap="outerHTML"
		hx-status:422={ "target:#errors-" + RoomGridPanel + ",swap:outerHTML" }
	>
		@PanelFormErrors(RoomGridPanel, data.Errors)
		@gridRadios("gridLines", "Grid lines", GridLineChoices(), data.Lines)
		<div class="grid grid-cols-2 gap-2">
			@gridNumber("cellSize", "Cell size", data.CellSizeText(), GridCellMin, GridCellMax)
			@gridNumber("feetPerCell", "Feet per cell", data.FeetText(), GridFeetMin, GridFeetMax)
			@gridNumber("offsetX", "Offset across", data.OffsetXText(), "", "")
			@gridNumber("offsetY", "Offset down", data.OffsetYText(), "", "")
		</div>
		@gridColor(data)
		@gridRadios("snap", "Snapping", GridSnapChoices(), data.Snap)
		@gridRadios("diagonals", "Diagonals", GridDiagonalChoices(), data.Diagonals)
		@gridRadios("pawnLabels", "What a pawn is labelled with", PawnLabelChoices(), data.PawnLabels)
		@gridToggle("playersCanDraw", "Players may draw on the tabletop", data.PlayersCanDraw)
	</form>
}

templ gridNumber(name string, caption string, value string, min string, max string) {
	<label class="flex flex-col gap-0.5">
		<span class="text-[10px] text-base-content/60">{ caption }</span>
		<input
			type="number"
			name={ name }
			value={ value }
			required
			if min != "" {
				min={ min }
			}
			if max != "" {
				max={ max }
			}
			class="input input-xs w-full"
		/>
	</label>
}

templ gridColor(data RoomGridData) {
	<label class="flex flex-col gap-0.5">
		<span class="text-[10px] text-base-content/60">Colour</span>
		<span class="flex items-center gap-1.5">
			<input
				type="color"
				value={ data.ColorRGB() }
				aria-label="Pick a grid colour"
				class="h-6 w-8 shrink-0 cursor-pointer rounded-sm border border-base-300 bg-transparent p-0"
				hx-on:input="const t = this.parentElement.querySelector('[name=color]'); t.value = this.value.toUpperCase() + (t.value.length === 9 ? t.value.slice(7) : 'FF'); t.dispatchEvent(new Event('change', { bubbles: true }))"
			/>
			<input
				type="text"
				name="color"
				value={ data.Color }
				required
				pattern={ GridColorPat }
				aria-label="Grid colour, as hex"
				class="input input-xs min-w-0 flex-1 font-mono"
			/>
		</span>
	</label>
}

templ gridRadios(name string, caption string, choices []Choice, chosen string) {
	<fieldset class="flex flex-col gap-0.5">
		<legend class="text-[10px] text-base-content/60">{ caption }</legend>
		for _, c := range choices {
			<label class="flex items-start gap-1.5 py-0.5">
				<input
					type="radio"
					name={ name }
					value={ c.Value }
					checked?={ c.Value == chosen }
					class="radio radio-xs mt-0.5 shrink-0"
				/>
				<span class="min-w-0 text-xs leading-tight">
					{ c.Label }
					if c.Hint != "" {
						<span class="block text-[10px] text-base-content/50">{ c.Hint }</span>
					}
				</span>
			</label>
		}
	</fieldset>
}

templ gridToggle(name string, caption string, on bool) {
	<label class="flex items-center gap-2">
		<input type="checkbox" name={ name } value="on" checked?={ on } class="toggle toggle-xs shrink-0"/>
		<span class="text-xs">{ caption }</span>
	</label>
}
