package pages

import "strconv"

templ AccountSettingsFragment(data AccountSettingsData) {
	{{ errorBlock := "#errors-" + AccountSettingsPanel }}
	<div id={ accountSettingsID } class="grid gap-4">
		<h3 class="m-0 pr-10 font-serif text-xl leading-none">Account settings</h3>
		<form
			class="grid gap-4"
			hx-post="/account/settings"
			hx-target={ errorBlock }
			hx-swap="outerHTML"
			hx-status:422={ "target:" + errorBlock + ",swap:outerHTML" }
		>
			@PanelFormErrors(AccountSettingsPanel, []string{})
			@accountSettingsFields(data)
			if data.Storage != "" {
				<div class="flex flex-row flex-nowrap items-baseline justify-between gap-4 border-t border-base-content/15 pt-4">
					<span class="text-sm text-base-content/75">Storage used</span>
					<span class="font-medium tabular-nums">{ data.Storage }</span>
				</div>
			}
			<div class="modal-action">
				<button
					type="button"
					class="btn btn-error mr-auto"
					hx-delete="/account"
					hx-swap="none"
					hx-params="none"
					hx-confirm="You are about to delete your account. Every character, monster, room, scene, map and upload you own will be deleted, you are signed out straight away, and signing in again starts a fresh account. This action cannot be undone."
					data-confirm-heading="Delete your account?"
					data-confirm-label="Delete my account"
				>Delete account</button>
				<button
					type="button"
					class="btn border-base-content/50"
					hx-on:click="window.dispatchEvent(new CustomEvent('modal:close'))"
				>Close</button>
				<button type="submit" class="btn btn-primary">Save settings</button>
			</div>
		</form>
	</div>
}

templ AccountWelcomeFragment(data AccountSettingsData) {
	{{ errorBlock := "#errors-" + AccountWelcomePanel }}
	<div id={ accountWelcomeID } class="grid gap-4">
		<h3 class="m-0 pr-10 font-serif text-xl leading-none">Welcome to Tabletopper</h3>
		<p class="m-0 text-base-content/75">Your account is ready. Before diving into everything Tabletopper has to offer, let's get your preferences set up. You can change all of this later from the gear at the bottom of the home page at any time.</p>
		<form
			class="grid gap-4"
			hx-post="/account/welcome"
			hx-target={ errorBlock }
			hx-swap="outerHTML"
			hx-status:422={ "target:" + errorBlock + ",swap:outerHTML" }
		>
			@PanelFormErrors(AccountWelcomePanel, []string{})
			<zone-detect class="contents">
				@accountSettingsFields(data)
			</zone-detect>
			<div class="modal-action">
				<button
					type="button"
					class="btn border-base-content/50"
					hx-post="/account/welcome/skip"
					hx-swap="none"
				>Not now</button>
				<button type="submit" class="btn btn-primary">Save and get started</button>
			</div>
		</form>
	</div>
}

templ AccountName(name string) {
	<span id="account-name" class="mt-1 inline-block text-xl font-bold text-primary">{ name }</span>
}

templ accountSettingsFields(data AccountSettingsData) {
	@displayNameField(data.Name)
	<div class="grid gap-4 sm:grid-cols-2 sm:gap-x-8">
		<div class="grid content-start gap-4">
			@selectField("theme", "Theme", data.Themes, data.Theme, true)
			@zoneField(data.Zones, data.Zone)
			@selectField("date_format", "Date format", data.DateFormats, data.DateFormat, true)
			@selectField("time_format", "Clock", data.TimeFormats, data.TimeFormat, true)
		</div>
		<div class="grid content-start gap-4">
			@tabletopFields(data)
		</div>
	</div>
	@soundFields(data)
}

templ soundFields(data AccountSettingsData) {
	<div class="fieldset">
		<span class="fieldset-legend">Sounds</span>
		<div class="grid gap-4 sm:grid-cols-2 sm:gap-x-8">
			@volumeField(
				"ping-volume",
				"ping_volume",
				"Ping volume",
				"How loud it is when somebody points at the tabletop.",
				PingVolumeOutputID,
				data.PingVolumeValue(),
				"ping",
			)
			@volumeField(
				"turn-volume",
				"turn_volume",
				"Turn alert volume",
				"How loud the chime is when your turn is the next one up.",
				TurnVolumeOutputID,
				data.TurnVolumeValue(),
				"turn",
			)
			<div class="sm:col-span-2">
				@volumeField(
					"music-volume",
					"music_volume",
					"Music volume",
					"",
					MusicVolumeOutputID,
					data.MusicVolumeValue(),
					"",
				)
			</div>
		</div>
	</div>
}

templ volumeField(id string, name string, label string, description string, output string, value string, preview string) {
	<div class="grid content-start gap-1">
		<label class="font-medium" for={ id }>{ label }</label>
		if description != "" {
			<p class="m-0 text-sm text-base-content/75">{ description }</p>
		}
		<div class="mt-2 flex items-center gap-3">
			<div class="min-w-0 flex-1">
				<input
					id={ id }
					name={ name }
					type="range"
					min="0"
					max={ VolumeMax }
					step={ VolumeStep }
					value={ value }
					data-range-output={ output }
					if preview != "" {
						data-sound-preview={ preview }
					}
					class="range range-sm w-full"
				/>
				<div class="flex justify-between text-xs text-base-content/60">
					<span>Silent</span>
					<span>Full</span>
				</div>
			</div>
			<output
				id={ output }
				for={ id }
				aria-hidden="true"
				class="w-12 shrink-0 text-right font-mono text-sm"
			><span data-range-value>{ value }</span>%</output>
		</div>
	</div>
}

templ tabletopFields(data AccountSettingsData) {
	<div class="fieldset">
		<span class="fieldset-legend">Tabletop</span>
		<div class="grid gap-4">
			@tabletopToggle("follow-turn", "follow_turn", "Follow the turn", "Move the tabletop to whoever's turn it is.", data.FollowTurn)
			@tabletopToggle("show-blood", "show_blood", "Show blood", "Mark the tabletop where a creature is hit with a splatter of blood, and a pool of it where one dies.", data.ShowBlood)
			@tabletopToggle("turn-alert", "turn_alert", "Tell me when I'm on deck", "Raise a banner and sound a chime when your turn is the next one up.", data.TurnAlert)
			@turnNotifyField(data)
		</div>
	</div>
}

templ turnNotifyField(data AccountSettingsData) {
	<div class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1">
		<label class="col-start-1 row-start-1 font-medium" for="turn-notify">Tell me in another tab too</label>
		<input
			id="turn-notify"
			name="turn_notify"
			type="checkbox"
			class="toggle col-start-2 row-start-1"
			data-notify-permission
			checked?={ data.TurnNotify }
		/>
		<p class="col-span-2 m-0 text-sm text-base-content/75">Post a desktop notification as well, for when Tabletopper is not the tab you are looking at. Your browser will ask permission.</p>
		<p data-notify-blocked hidden class="col-span-2 m-0 text-sm text-warning">This browser is not showing Tabletopper's notifications. Allow them in its site settings to turn them on; the banner and the chime carry on either way.</p>
	</div>
}

templ tabletopToggle(id string, name string, label string, description string, checked bool) {
	<div class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1">
		<label class="col-start-1 row-start-1 font-medium" for={ id }>{ label }</label>
		<input
			id={ id }
			name={ name }
			type="checkbox"
			class="toggle col-start-2 row-start-1"
			checked?={ checked }
		/>
		<p class="col-span-2 m-0 text-sm text-base-content/75">{ description }</p>
	</div>
}

templ displayNameField(value string) {
	<div class="fieldset">
		<label class="fieldset-legend" for="username">Display name</label>
		<input
			id="username"
			name="username"
			type="text"
			class="input validator peer w-full"
			value={ value }
			maxlength={ strconv.Itoa(DisplayNameLimit) }
			autocomplete="nickname"
			required
		/>
		<p class="validator-hint hidden peer-user-invalid:block text-hint">This field is required.</p>
	</div>
}

templ zoneField(groups []ZoneGroup, value string) {
	<div class="fieldset">
		<label class="fieldset-legend" for="timezone">Time zone</label>
		<select id="timezone" name="timezone" class="select w-full" required>
			for _, group := range groups {
				<optgroup label={ group.Label }>
					for _, zone := range group.Zones {
						<option
							value={ zone.Value }
							if zone.Alias != "" {
								data-alias={ zone.Alias }
							}
							selected?={ zone.Value == value }
						>{ zone.Label }</option>
					}
				</optgroup>
			}
		</select>
	</div>
}
