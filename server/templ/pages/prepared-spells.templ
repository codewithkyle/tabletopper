package pages

templ preparedSpells(characterID string, groups []PreparedSpellGroup) {
	if len(groups) == 0 {
		<p class="text-base-content/75">
			Nothing is prepared yet. Tick <span class="font-medium">Prepared</span> on anything in
			<a href={ "/characters/" + characterID + "/edit/spells" } class="link">your spells</a>.
		</p>
	} else {
		<div class="grid w-full gap-4">
			for _, group := range groups {
				<section class="grid gap-2">
					<h3 class="m-0 font-serif text-sm leading-none font-bold">{ group.Name }</h3>
					<ul class="grid w-full gap-2">
						for _, spell := range group.Spells {
							{{ meta := spellMetaLine(spell) }}
							<li class="rounded-field border-2 border-base-300 p-3">
								<p class="m-0 font-medium">{ preparedSpellName(spell) }</p>
								if meta != "" {
									<p class="mt-1 text-sm text-base-content/75">{ meta }</p>
								}
							</li>
						}
					</ul>
				</section>
			}
		</div>
	}
}
