package pages

import "strconv"

templ spellLevelTabs(characterID string, active int) {
	{{ base := "/characters/" + characterID + "/edit/spells/" }}
	<div class="overflow-x-auto">
		<nav class={ barGutter + " flex w-max min-w-full gap-1 py-2" } aria-label="Spell levels">
			for level := 0; level <= MaxSpellLevel; level++ {
				@spellLevelTabLink(base+strconv.Itoa(level), SpellLevelTab(level), active == level)
			}
		</nav>
	</div>
}

templ spellLevelTabLink(href string, name string, current bool) {
	if current {
		<a
			href={ href }
			aria-current="page"
			class={ tabGutter + " shrink-0 rounded-field bg-base-content/15 py-1.5 text-sm font-bold transition-colors duration-150" }
		>{ name }</a>
	} else {
		<a
			href={ href }
			class={ tabGutter + " shrink-0 rounded-field py-1.5 text-sm font-semibold text-base-content/60 transition-colors duration-150 hover:bg-base-content/10 hover:text-base-content" }
		>{ name }</a>
	}
}
