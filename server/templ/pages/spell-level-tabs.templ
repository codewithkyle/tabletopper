package pages

templ spellLevelTabs(characterID string, active int) {
	<div class="overflow-x-auto">
		<nav class={ barGutter + " flex w-max min-w-full gap-1 py-2" } aria-label="Spell levels">
			for _, level := range spellLevelChoices() {
				@spellLevelTabLink(SpellLevelEditPath(characterID, level), SpellLevelTab(level), active == level)
			}
		</nav>
	</div>
}

templ spellLevelTabLink(href string, name string, current bool) {
	if current {
		<a href={ href } aria-current="page" class={ levelActive }>{ name }</a>
	} else {
		<a href={ href } class={ levelIdle }>{ name }</a>
	}
}
