package pages

import "tabletopper/templ/layouts"

// ClerkFrontend is what the sign-in and sign-up pages need from the server's
// config to load Clerk's browser SDK: the publishable key and the script's
// URL on the instance's frontend API. The controller builds it; the pages
// used to hardcode both environments and pick one by sniffing the hostname.
type ClerkFrontend struct {
	PublishableKey string
	ScriptURL      string
}

templ SignIn(clerk ClerkFrontend) {
	@layouts.Base("Sign In | Tabletopper") {
		@clerkMount("sign-in", clerk)
	}
}

templ SignUp(clerk ClerkFrontend) {
	@layouts.Base("Sign Up | Tabletopper") {
		@clerkMount("sign-up", clerk)
	}
}

// clerkMount is the element Clerk's UI lands in and the two scripts that put
// it there: Clerk's own, loaded the way Clerk documents it, and
// clerk-mount.js, which decides between the sign-in and sign-up forms from
// the data attribute.
templ clerkMount(mode string, clerk ClerkFrontend) {
	<div data-clerk-mount={ mode }></div>
	<script async crossorigin="anonymous" data-clerk-publishable-key={ clerk.PublishableKey } src={ clerk.ScriptURL }></script>
	<script type="module" src="/js/clerk-mount.js"></script>
}
