package pages

templ AttackRow(characterID string, attack Attack) {
	{{ action := "/characters/" + characterID + "/attacks/" + attack.ID }}
	{{ panel := AttackRowPanel(attack.ID) }}
	<form
		data-attack-row="true"
		data-sort-row={ attack.ID }
		class={ surfaceInset + " @container grid gap-3 p-3" }
		hx-post={ action }
		hx-trigger="input delay:1s"
		hx-target={ "#errors-" + panel }
		hx-swap="outerHTML"
		hx-status:422={ "target:#errors-" + panel + ",swap:outerHTML" }
		{ autosaves... }
	>
		@PanelFormErrors(panel, []string{})
		<div class="grid grid-cols-[5rem_minmax(0,1fr)_minmax(0,1fr)_auto] items-end gap-3 @[44rem]:grid-cols-[minmax(0,1fr)_6rem_8rem_10rem_auto]">
			<div class="col-span-full flex min-w-0 items-end gap-1 @[44rem]:col-span-1">
				@rowHandle("Move " + attackRowName(attack))
				<label class="fieldset min-w-0 flex-1">
					<span class={ "fieldset-legend " + denseLegend }>Attack</span>
					<input
						name="name"
						type="text"
						class={ "input w-full font-medium " + denseInput }
						value={ attack.Name }
						placeholder="Longsword"
						maxlength="128"
						autofocus?={ attack.Fresh }
					/>
				</label>
			</div>
			<label class="fieldset">
				<span class={ "fieldset-legend " + denseLegend }>ATK/DC</span>
				<input
					name="attack_bonus"
					type="text"
					class={ "input w-full text-right " + denseInput }
					value={ attack.Bonus }
					placeholder="+7"
					maxlength="32"
				/>
			</label>
			<label class="fieldset">
				<span class={ "fieldset-legend " + denseLegend }>Damage</span>
				<input
					name="damage"
					type="text"
					class={ "input w-full text-right " + denseInput }
					value={ attack.Damage }
					placeholder="1d8+3"
					maxlength="64"
				/>
			</label>
			<label class="fieldset">
				<span class={ "fieldset-legend " + denseLegend }>Type</span>
				<select name="damage_type" class={ "select w-full " + denseSelect }>
					for _, option := range damageTypeOptions {
						<option value={ option.Value } selected?={ option.Value == attack.DamageType }>{ option.Label }</option>
					}
				</select>
			</label>
			@rowDelete(action, "Delete "+attackRowName(attack))
		</div>
		@rowDetails("attack-details") {
			<div class="grid gap-3">
				<label class="fieldset">
					<span class={ "fieldset-legend " + denseLegend }>Mastery</span>
					<select name="mastery" class={ "select w-full @[38rem]:w-48 " + denseSelect }>
						for _, option := range masteryOptions {
							<option value={ option.Value } selected?={ option.Value == attack.Mastery }>{ option.Label }</option>
						}
					</select>
				</label>
				<label class="fieldset">
					<span class={ "fieldset-legend " + denseLegend }>Notes</span>
					<textarea
						name="notes"
						class={ "textarea w-full " + denseTextarea }
						rows="2"
						placeholder="Reach, thrown 20/60, and anything worth reading mid-turn."
					>{ attack.Notes }</textarea>
				</label>
			</div>
		}
	</form>
}

templ attacksTable(characterID string, attacks []Attack) {
	<div
		id="attack-rows"
		class="grid gap-3"
		data-sort-list="attack-order"
	>
		<p class="hidden text-base-content/70 only:block">No attacks yet. Start one with the Add Attack button above.</p>
		for _, attack := range attacks {
			@AttackRow(characterID, attack)
		}
	</div>
	@rowOrderSave("attack-order", "/characters/"+characterID+"/attacks/order")
}

templ attackAddButton(characterID string, class string) {
	<button
		type="button"
		class={ class }
		hx-post={ "/characters/" + characterID + "/attacks" }
		hx-target="#attack-rows"
		hx-swap="beforeend"
	>
		Add Attack
	</button>
}
