package pages

import "tabletopper/templ/layouts"

templ Room(data RoomPageData) {
	@layouts.Base(data.Name+" | Tabletopper", "/js/room.js", data.Bundle()) {
		@roomContent(data)
	}
}

templ RoomLockItem(data RoomPageData) {
	@roomBarItem(roomLockItem(data))
}

templ roomContent(data RoomPageData) {
	<room-page class="relative block h-dvh w-screen overflow-hidden">
		<div class="grid h-full w-full grid-rows-[auto_minmax(0,1fr)]">
			@appBar() {
				<div data-room-bar class="flex h-9 items-center gap-0.5 px-2">
					<span class="max-w-56 truncate px-2 text-xs font-semibold">{ data.Name }</span>
					for _, m := range data.Menus() {
						@roomBarMenu(m)
					}
				</div>
			}
			<div
				id="tabletop"
				class="relative min-h-0 min-w-0 bg-base-300"
				data-room={ data.ID }
				data-role={ data.RoleName() }
				data-version={ data.Version }
				if data.Socket != "" {
					data-socket={ data.Socket }
				}
			>
				if data.Closed {
					<p class="absolute inset-0 m-0 grid place-content-center px-6 text-center text-base-content/60">
						This room is closed. Reopen it from the Room menu to get a new code.
					</p>
				}
				@roomPlayers(data)
				@roomToolbar()
				if data.Debug {
					@roomDebug()
				}
			</div>
		</div>
	</room-page>
}

templ roomBarMenu(m RoomMenu) {
	<details data-room-menu class="dropdown">
		<summary class="btn btn-ghost btn-xs list-none font-normal [&::-webkit-details-marker]:hidden">{ m.Label }</summary>
		<ul class="menu dropdown-content menu-sm z-30 mt-1 w-56 rounded-box border border-base-300 bg-panel/95 p-1 shadow-panel backdrop-blur-sm">
			for _, item := range m.Items {
				@roomBarItem(item)
			}
		</ul>
	</details>
}

templ roomBarItem(item RoomMenuItem) {
	<li
		if item.ID != "" {
			id={ item.ID }
		}
		if item.Disabled {
			class="menu-disabled"
		}
	>
		if item.Disabled {
			<button type="button" disabled>{ item.Label }</button>
		} else if item.Href != "" {
			<a
				href={ item.Href }
				if item.NewTab {
					target="_blank"
					rel="noopener noreferrer"
				}
			>{ item.Label }</a>
		} else if item.Post != "" {
			<button
				type="button"
				hx-post={ item.Post }
				if item.ID != "" {
					hx-target={ "#" + item.ID }
					hx-swap="outerHTML"
				}
				if item.Confirm != "" {
					hx-confirm={ item.Confirm }
				}
				if item.ConfirmHeading != "" {
					data-confirm-heading={ item.ConfirmHeading }
				}
				if item.ConfirmLabel != "" {
					data-confirm-label={ item.ConfirmLabel }
				}
				if item.Danger {
					class="text-error"
				}
			>{ item.Label }</button>
		} else {
			<button
				type="button"
				data-room-action={ item.Action }
				if item.Value != "" {
					data-room-value={ item.Value }
				}
			>{ item.Label }</button>
		}
	</li>
}

templ roomToolbar() {
	<div data-room-tools class={ surfacePanel + " absolute top-3 right-3 z-10 flex flex-col gap-1 rounded-full p-1" }>
		for _, t := range RoomTools() {
			<div class="tooltip tooltip-left" data-tip={ t.Label }>
				<button
					type="button"
					class="btn btn-circle btn-ghost btn-sm aria-pressed:bg-primary aria-pressed:text-primary-content"
					data-room-tool={ t.Name }
					aria-label={ t.Label }
					aria-pressed={ t.Pressed() }
				>
					@roomToolIcon(t.Name)
				</button>
			</div>
		}
	</div>
}

templ roomToolIcon(name string) {
	switch name {
		case "measure":
			@rulerIcon()
		case "fog":
			@cloudIcon()
		case "draw":
			@brushIcon()
		default:
			@moveIcon()
	}
}

templ roomPlayers(data RoomPageData) {
	<div
		data-room-window="players"
		hidden
		class={ surfacePanel + " absolute top-3 left-3 z-10 w-60 rounded-box p-2" }
	>
		<div class="flex items-center justify-between gap-2 px-2 pb-1">
			<h2 class="text-xs font-semibold">Players</h2>
			<button
				type="button"
				class="btn btn-ghost btn-xs"
				data-room-action="window"
				data-room-value="players"
			>Close</button>
		</div>
		<div
			id="room-members"
			hx-get={ data.MembersPath() }
			hx-trigger="load, room:players from:window"
			hx-sync="this:replace"
			hx-swap="outerHTML"
		></div>
	</div>
}

templ roomDebug() {
	<details
		data-room-debug
		class={ surfacePanel + " absolute bottom-3 left-3 z-10 w-96 max-w-[calc(100vw-1.5rem)] rounded-box p-2 text-xs" }
	>
		<summary class="cursor-pointer px-1 font-semibold">Debug</summary>
		<div class="mt-2 flex flex-col gap-2">
			<dl class="grid grid-cols-[auto_1fr] gap-x-3 px-1">
				<dt class="text-base-content/60">Connection</dt>
				<dd data-debug-connection class="truncate"></dd>
				<dt class="text-base-content/60">Sequence</dt>
				<dd data-debug-seq class="truncate"></dd>
				<dt class="text-base-content/60">Build</dt>
				<dd data-debug-version class="truncate"></dd>
				<dt class="text-base-content/60">Layer</dt>
				<dd data-debug-layer class="truncate font-mono"></dd>
			</dl>
			<div class="px-1">
				<p class="text-base-content/60">Players</p>
				<ul data-debug-players class="mt-0.5"></ul>
			</div>
			<div class="px-1">
				<p class="text-base-content/60">Events</p>
				<ol data-debug-events class="mt-0.5 max-h-48 overflow-y-auto font-mono text-[10px] leading-tight"></ol>
			</div>
			<form data-debug-form class="flex flex-col gap-1 px-1">
				<textarea
					data-debug-input
					class="textarea textarea-xs w-full font-mono"
					rows="2"
					placeholder="A command, as JSON"
				></textarea>
				<button type="submit" class="btn btn-xs self-end">Send</button>
			</form>
		</div>
	</details>
}
