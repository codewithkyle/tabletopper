package pages

templ MonsterImageControl(image MonsterImage) {
	<monster-image class="relative block w-full">
		<div class="avatar avatar-placeholder w-full rounded-full border border-base-300">
			<div class="relative w-full rounded-full bg-base-300 text-base-content">
				<span class="font-serif text-xl font-bold">{ characterInitial(image.Name) }</span>
				if image.ImageID != "" {
					<img class="absolute inset-0 h-full w-full rounded-full object-cover select-none" src={ "/assets/images/" + image.ImageID } alt={ image.Name }/>
				}
			</div>
		</div>
		<label
			aria-label={ image.Verb() + " monster image" }
			class="tooltip absolute -top-1 -right-1 z-10 flex h-6 w-6 cursor-pointer items-center justify-center rounded-full border border-base-300 bg-base-200 shadow-sm"
			data-tip={ image.Verb() + " image" }
			for={ monsterImageInputID(image.MonsterID) }
		>
			@pencilIcon()
			<input
				class="absolute h-0 w-0 opacity-0"
				id={ monsterImageInputID(image.MonsterID) }
				type="file"
				name="image"
				accept="image/png, image/jpeg, image/webp"
				required
				hx-post={ "/monsters/" + image.MonsterID + "/image" }
				hx-target="closest monster-image"
				hx-swap="outerHTML"
				hx-encoding="multipart/form-data"
			/>
		</label>
	</monster-image>
}
