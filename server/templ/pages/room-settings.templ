package pages

templ RoomSettings(data RoomSettingsData) {
	<form
		id="room-settings"
		class="flex flex-col gap-3"
		hx-post={ data.SavePath() }
		hx-trigger="change"
		hx-sync="this:queue last"
		hx-target={ "#errors-" + RoomSettingsPanel }
		hx-swap="outerHTML"
		hx-status:422={ "target:#errors-" + RoomSettingsPanel + ",swap:outerHTML" }
		{ autosaves... }
	>
		@PanelFormErrors(RoomSettingsPanel, data.Errors)
		@panelRadios("pawnLabels", "What a pawn is labelled with", PawnLabelChoices(), data.PawnLabels)
		@panelRadios("initiativeGrouping", "How monsters take their turns", InitiativeGroupingChoices(), data.InitiativeGrouping)
		@panelToggle("playersCanDraw", "Players may draw on the tabletop", "", data.PlayersCanDraw)
		@panelToggle("fogPrefill", "Prefill fog", "A floor added from now on starts covered. Floors that are already here do not change.", data.FogPrefill)
	</form>
}
