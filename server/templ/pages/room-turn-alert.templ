package pages

templ roomTurnAlert() {
	<div
		data-on-deck
		hidden
		role="status"
		aria-live="polite"
		class={ surfacePanel + " pointer-events-none mt-1 flex max-w-[min(22rem,90vw)] items-center gap-3 rounded-box py-2 pr-2 pl-3" }
	>
		<span class="grid size-8 shrink-0 place-content-center rounded-full bg-warning/20 text-warning">
			@hourglassIcon()
		</span>
		<span class="grid min-w-0 gap-0.5">
			<span class="text-sm leading-none font-semibold">You're on deck</span>
			<span data-on-deck-line class="truncate text-xs leading-tight text-base-content/75"></span>
		</span>
		<button
			type="button"
			data-on-deck-close
			aria-label="Dismiss"
			class="btn btn-ghost btn-xs pointer-events-auto ml-auto shrink-0 px-1"
		>
			@windowCloseIcon()
		</button>
	</div>
}
