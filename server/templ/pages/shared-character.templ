package pages

import "tabletopper/templ/layouts"

templ SharedCharacterPage(data SharedCharacterSheet) {
	@layouts.Share(SharedCharacterTitle(data.Header.Name), true) {
		@sharedSheetBanner(data)
		<div class="grid grid-cols-[24rem_minmax(0,1fr)] items-start gap-4 max-[1280px]:grid-cols-1">
			<div class="grid content-start gap-4">
				if len(data.Abilities) > 0 {
					@sheetPanel("Abilities") {
						<div class="@container">
							<div class="grid grid-cols-2 gap-3 @[20rem]:grid-cols-3 @[52rem]:grid-cols-6">
								for _, ability := range data.Abilities {
									<div class={ surfaceInset + " grid justify-items-center gap-1 p-3" }>
										<span class="text-center text-xs font-semibold tracking-wider uppercase text-base-content/75">{ ability.Label }</span>
										<span class="text-2xl leading-none font-extrabold tabular-nums">{ ability.Score }</span>
										@derivedValue("", ability.Mod, false)
									</div>
								}
							</div>
						</div>
					}
				}
				if len(data.SavingThrows) > 0 {
					@sheetPanel("Saving Throws") {
						@sharedBonusGrid(data.SavingThrows)
					}
				}
			</div>
			<div class="grid content-start gap-4">
				if len(data.Identity) > 0 {
					@sheetPanel("Identity") {
						@sharedFactGrid(data.Identity)
					}
				}
				if len(data.CoreStats) > 0 {
					@sheetPanel("Core Stats") {
						@sharedFactGrid(data.CoreStats)
						if len(data.Spellcasting) > 0 {
							<div class={ surfaceInset + " flex flex-wrap items-center gap-x-8 gap-y-2 p-3" }>
								for _, entry := range data.Spellcasting {
									<span class="flex items-center gap-3">
										<span class="text-sm font-semibold tracking-wider uppercase text-base-content/75">{ entry.Label }</span>
										@derivedValue("", entry.Value, false)
									</span>
								}
							</div>
						}
					}
				}
				if len(data.Vitals) > 0 {
					@sheetPanel("Vitals") {
						@sharedFactGrid(data.Vitals)
					}
				}
				if len(data.Attacks) > 0 {
					@sheetPanel("Attacks") {
						<ul class="grid w-full gap-2">
							for _, attack := range data.Attacks {
								<li class={ surfaceInset + " grid gap-1 p-3" }>
									<p class="m-0 flex flex-wrap items-baseline gap-x-3">
										<span class="font-medium">{ attack.Name }</span>
										if attack.Bonus != "" {
											<span class="text-sm font-semibold tabular-nums text-base-content/75">{ attack.Bonus }</span>
										}
									</p>
									if attack.Damage != "" || attack.DamageType != "" || attack.Mastery != "" {
										<p class="m-0 flex flex-wrap gap-x-2 text-sm text-base-content/75">
											if attack.Damage != "" {
												<span class="tabular-nums">{ attack.Damage }</span>
											}
											if attack.DamageType != "" {
												<span>{ attack.DamageType }</span>
											}
											if attack.Mastery != "" {
												<span class="badge badge-neutral badge-sm">{ attack.Mastery }</span>
											}
										</p>
									}
									if attack.Notes != "" {
										<p class="m-0 whitespace-pre-line text-sm text-base-content/75">{ attack.Notes }</p>
									}
								</li>
							}
						</ul>
					}
				}
				if len(data.Training) > 0 {
					@sheetPanel("Proficiencies & Training") {
						@sharedProseList(data.Training)
					}
				}
				if len(data.Skills) > 0 {
					@sheetPanel("Skills") {
						<div class="@container grid gap-3">
							<p class={ surfaceInset + " flex items-center justify-between gap-3 px-3 py-2" }>
								<span class="text-sm font-semibold tracking-wider uppercase text-base-content/75">Passive Perception</span>
								@derivedValue("", data.PassivePerception, false)
							</p>
							@sharedBonusGrid(data.Skills)
						</div>
					}
				}
				if len(data.Features) > 0 || len(data.Equipped) > 0 {
					<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
						if len(data.Features) > 0 {
							@sheetPanel("Features & Traits") {
								@sharedProseList(data.Features)
							}
						}
						if len(data.Equipped) > 0 {
							@sheetPanel("Equipment") {
								<ul class="grid w-full gap-3">
									for _, item := range data.Equipped {
										<li class={ surfaceInset + " p-3" }>
											<p class="m-0 flex flex-wrap items-baseline justify-between gap-x-3 font-medium">
												<span>{ item.Name }</span>
												if item.Quantity != "" {
													<span class="text-sm font-semibold text-base-content/75">&#215; { item.Quantity }</span>
												}
											</p>
											if item.Description != "" {
												<p class="m-0 mt-2 whitespace-pre-line text-base-content/75">{ item.Description }</p>
											}
										</li>
									}
								</ul>
							}
						}
					</div>
				}
				if len(data.Prepared) > 0 || len(data.SpellSlots) > 0 {
					<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
						if len(data.Prepared) > 0 {
							@sheetPanel("Prepared Spells") {
								<div class="grid w-full gap-4">
									for _, group := range data.Prepared {
										<section class="grid gap-2">
											<h3 class="m-0 font-serif text-sm leading-none font-bold">{ group.Name }</h3>
											<ul class="grid w-full gap-2">
												for _, spell := range group.Spells {
													<li class={ surfaceInset + " p-3" }>
														<p class="m-0 font-medium">{ spell.Name }</p>
														if spell.Meta != "" {
															<p class="m-0 mt-1 text-sm text-base-content/75">{ spell.Meta }</p>
														}
														if spell.Description != "" {
															<details class="group mt-2">
																<summary class="line-clamp-2 cursor-pointer whitespace-pre-line text-sm text-base-content/75 transition-colors duration-150 group-open:line-clamp-none hover:text-base-content">{ spell.Description }</summary>
															</details>
														}
													</li>
												}
											</ul>
										</section>
									}
								</div>
							}
						}
						if len(data.SpellSlots) > 0 {
							@sheetPanel("Spell Slots") {
								<ul class="grid w-full gap-3">
									for _, level := range data.SpellSlots {
										<li class={ surfaceInset + " flex flex-wrap items-center justify-between gap-3 p-3" }>
											<span class="flex min-w-0 flex-col gap-1">
												<span class="font-serif text-base leading-none font-bold">{ level.Name }</span>
												<span class="text-xs font-semibold text-base-content/75">{ level.Spells }</span>
											</span>
											<span class="text-sm text-base-content/60">{ level.Slots }</span>
										</li>
									}
								</ul>
							}
						}
					</div>
				}
				if len(data.Personality) > 0 || len(data.Appearance) > 0 {
					<div class="grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
						if len(data.Personality) > 0 {
							@sheetPanel("Personality") {
								@sharedProseList(data.Personality)
							}
						}
						if len(data.Appearance) > 0 {
							@sheetPanel("Appearance") {
								@sharedFactGrid(data.Appearance)
							}
						}
					</div>
				}
			</div>
		</div>
	}
}

templ sharedSheetBanner(data SharedCharacterSheet) {
	<header class={ surfacePanel + " rounded-box" }>
		<div class="flex flex-wrap items-center gap-x-6 gap-y-3 px-6 py-4 max-[900px]:px-4">
			<div class="flex min-w-0 items-center gap-3">
				<div class="avatar avatar-placeholder shrink-0 rounded-full border border-base-300">
					<div class="relative w-14 rounded-full bg-base-300 text-base-content">
						<span class="font-serif text-xl font-bold">{ characterInitial(data.Header.Name) }</span>
						if data.Avatar != "" {
							<img class="absolute inset-0 h-full w-full rounded-full object-cover select-none" src={ data.Avatar } alt=""/>
						}
					</div>
				</div>
				<div class="min-w-0">
					<h1 class="m-0 truncate font-serif text-2xl leading-tight">{ characterBarName(data.Header) }</h1>
					if data.Header.Subtitle != "" {
						<p class="m-0 mt-0.5 truncate text-xs text-base-content/65">{ data.Header.Subtitle }</p>
					}
				</div>
			</div>
			<dl class="m-0 ml-auto flex flex-wrap items-stretch gap-2 max-[900px]:ml-0">
				for _, chip := range characterChips(data.Header) {
					<div class="min-w-18 rounded-field border border-base-300 bg-base-content/5 px-3 py-1 text-center">
						<dt class="text-[0.58rem] font-semibold tracking-[0.11em] uppercase text-base-content/60">{ chip.Label }</dt>
						<dd class="m-0 mt-0.5 text-lg leading-tight font-extrabold tabular-nums">
							{ chip.Value }
							if chip.Sub != "" {
								<span class="text-xs font-semibold text-base-content/60">{ chip.Sub }</span>
							}
						</dd>
					</div>
				}
			</dl>
		</div>
	</header>
}

templ sharedFactGrid(facts []SharedFact) {
	<div class="grid grid-cols-3 gap-3 max-[900px]:grid-cols-1">
		for _, fact := range facts {
			<div class={ surfaceInset + " grid gap-1 p-3" }>
				<span class="text-xs font-semibold tracking-wider uppercase text-base-content/60">{ fact.Label }</span>
				<span class="font-medium">{ fact.Value }</span>
			</div>
		}
	</div>
}

templ sharedProseList(facts []SharedFact) {
	<div class="grid w-full gap-3">
		for _, fact := range facts {
			<div class={ surfaceInset + " grid gap-1 p-3" }>
				<span class="text-xs font-semibold tracking-wider uppercase text-base-content/60">{ fact.Label }</span>
				<p class="m-0 whitespace-pre-line">{ fact.Value }</p>
			</div>
		}
	</div>
}

templ sharedBonusGrid(rows []SharedBonus) {
	<div class="@container">
		<div class="grid grid-cols-1 gap-2 @[44rem]:grid-cols-2">
			for _, row := range rows {
				<div class={ surfaceInset + " flex items-center gap-2 p-2" }>
					<span class="flex min-w-0 flex-1 flex-col gap-0.5">
						<span class="truncate text-sm font-medium">{ row.Label }</span>
						if row.Abbr != "" {
							<span class="text-xs font-semibold tracking-wider text-base-content/75">{ row.Abbr }</span>
						}
					</span>
					@derivedValue("", row.Total, false)
				</div>
			}
		</div>
	</div>
}
