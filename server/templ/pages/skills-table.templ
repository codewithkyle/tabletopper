package pages

templ skillsTable(rows []BonusRow, passivePerception string) {
	<div class="@container grid gap-3">
		<p class={ surfaceInset + " flex items-center justify-between gap-3 px-3 py-2" }>
			<span class="text-sm font-semibold tracking-wider uppercase text-base-content/75">Passive Perception</span>
			@derivedValue("passive-perception", passivePerception, false)
		</p>
		<div class="grid grid-cols-1 gap-2 @[44rem]:grid-cols-2">
			for _, row := range rows {
				@bonusRow("skills", row)
			}
		</div>
	</div>
}
