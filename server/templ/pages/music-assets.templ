package pages
import "tabletopper/templ/layouts"
templ MusicAssets(tracks []MusicTrack) {
	@layouts.Base("Music | Asset Manager | Tabletopper", "/js/music-upload.js") {
		@assetsShell(assetTabMusic, musicUploadButton()) {
			@MusicCards(tracks, "")
		}
	}
}
templ MusicCards(tracks []MusicTrack, query string) {
	@assetCards(musicGrid(query)) {
		for _, t := range tracks {
			@MusicCard(t)
		}
	}
}
templ MusicCard(t MusicTrack) {
	<asset-card class={ sheetSurface + " block p-4" }>
		<div class="flex flex-wrap items-center gap-x-4 gap-y-3">
			<div class="min-w-0 flex-1 basis-64">
				@assetNameBox(t.nameBox())
				<code class="inline-block h-6 max-w-full overflow-hidden rounded bg-base-content/5 px-1 text-xs leading-6 text-ellipsis whitespace-nowrap">{ t.FileName }</code>
			</div>
			<audio
				controls
				preload="none"
				class="h-10 min-w-0 flex-1 basis-72"
				src={ t.AudioURL() }
			></audio>
			@assetDeleteButton(t.URL(), t.Name)
		</div>
	</asset-card>
}
templ musicUploadButton() {
	<div class="flex flex-wrap items-center justify-end gap-3">
		<div class="flex min-w-0 items-center gap-2" data-music-progress hidden>
			<progress class="progress w-32" value="0" max="100" data-music-bar></progress>
			<span class="text-xs tabular-nums text-base-content/70" data-music-percent></span>
		</div>
		<label
			for="music-upload"
			class="btn btn-primary relative"
			data-music-label
		>
			@uploadIcon()
			Upload music
			<input
				class="absolute top-0 left-0 h-0 w-0 opacity-0"
				id="music-upload"
				type="file"
				accept={ MusicAccept }
				data-music-input
			/>
		</label>
	</div>
}
