package pages

import "tabletopper/templ/layouts"

templ EditCharacterJournal(data JournalPageData) {
	@layouts.Base("Journal | Tabletopper") {
		@editCharacterShell(data.CharacterID, data.Header, characterTabJournal, shellLayout{Actions: journalCreateForm(data.CharacterID)}) {
			@sheetPanel("Journal") {
				@journalSearchBox(data)
				<div id={ journalEntriesID } class="grid gap-3">
					@journalEntryList(data)
				</div>
			}
		}
	}
}

templ JournalEntriesFragment(data JournalPageData) {
	@journalEntryList(data)
}

templ journalCreateForm(characterID string) {
	<form method="post" action={ "/characters/" + characterID + "/journal" } class="max-[640px]:flex-1">
		<button type="submit" class="btn btn-primary w-full">New Entry</button>
	</form>
}

templ journalSearchBox(data JournalPageData) {
	<input
		type="search"
		name="q"
		class={ "input w-full " + denseInput }
		placeholder="Search this journal"
		aria-label="Search this journal"
		aria-controls={ journalEntriesID }
		autocomplete="off"
		maxlength="255"
		hx-get={ journalSearchPath(data) }
		hx-trigger="input changed delay:250ms, search"
		hx-target={ "#" + journalEntriesID }
		hx-swap="innerHTML"
	/>
}

templ journalEntryList(data JournalPageData) {
	for _, entry := range data.Entries {
		@journalEntryCard(data, entry)
	}
	if len(data.Entries) == 0 {
		if data.Query == "" {
			<p class="text-base-content/70">Nothing written down yet. Start one with the New Entry button above.</p>
		} else {
			<p class="text-base-content/70">No entries match &#34;{ data.Query }&#34;.</p>
		}
	}
}

templ journalEntryCard(data JournalPageData, entry JournalEntry) {
	<article class={ surfaceInset + " flex flex-wrap items-center justify-between gap-3 p-3" }>
		<div class="grid min-w-0 flex-1 gap-1">
			@journalEntryName(data, entry)
			if entry.Snippet.Match != "" {
				<p class="line-clamp-2 text-sm text-base-content/70">{ entry.Snippet.Before }<mark class="rounded-sm bg-warning/30 px-0.5 text-base-content">{ entry.Snippet.Match }</mark>{ entry.Snippet.After }</p>
			}
			<p class="flex flex-wrap gap-x-4 text-sm text-base-content/70">
				<span>
					Written&nbsp;
					<time datetime={ entry.Created.ISO }>{ entry.Created.Text }</time>
				</span>
				<span>
					Edited&nbsp;
					<time datetime={ entry.Updated.ISO }>{ entry.Updated.Text }</time>
				</span>
			</p>
		</div>
		<div class="flex items-center gap-2">
			@journalEntryOpen(data, entry)
			<button
				type="button"
				class="btn btn-soft btn-error btn-sm"
				hx-confirm={ "You are about to delete " + journalEntryTitle(entry) + ". This action cannot be undone." }
				hx-delete={ "/characters/" + data.CharacterID + "/journal/" + entry.ID }
				hx-target="closest article"
				hx-swap="delete"
			>
				Delete
			</button>
		</div>
	</article>
}

templ journalEntryName(data JournalPageData, entry JournalEntry) {
	if data.RoomID == "" {
		<a href={ journalEntryHref(data, entry) } class="font-medium hover:underline">{ journalEntryTitle(entry) }</a>
	} else {
		<button type="button" class="cursor-pointer text-left font-medium hover:underline" { journalOpens(data.RoomID, entry.ID)... }>{ journalEntryTitle(entry) }</button>
	}
}

templ journalEntryOpen(data JournalPageData, entry JournalEntry) {
	if data.RoomID == "" {
		<a href={ journalEntryHref(data, entry) } class="btn btn-soft btn-sm">View</a>
	} else {
		<button type="button" class="btn btn-soft btn-sm" { journalOpens(data.RoomID, entry.ID)... }>Open</button>
	}
}
