package pages

import "tabletopper/templ/layouts"

templ EditCharacterJournal(data JournalPageData) {
	@layouts.Base("Journal | Tabletopper") {
		@editCharacterShell(data.CharacterID, data.Header, characterTabJournal, shellLayout{Actions: journalCreateForm(data.CharacterID)}) {
			@sheetPanel("Journal") {
				@journalSearchBox(data.CharacterID)
				<div id={ journalEntriesID } class="grid gap-3">
					@journalEntryList(data)
				</div>
			}
		}
	}
}

templ JournalEntriesFragment(data JournalPageData) {
	@journalEntryList(data)
}

templ journalCreateForm(characterID string) {
	<form method="post" action={ "/characters/" + characterID + "/journal" } class="max-[640px]:flex-1">
		<button type="submit" class="btn btn-primary w-full">New Entry</button>
	</form>
}

templ journalSearchBox(characterID string) {
	<input
		type="search"
		name="q"
		class="input w-full"
		placeholder="Search this journal"
		aria-label="Search this journal"
		aria-controls={ journalEntriesID }
		autocomplete="off"
		maxlength="255"
		hx-get={ "/fragment/character/journal-entries?character=" + characterID }
		hx-trigger="input changed delay:250ms, search"
		hx-target={ "#" + journalEntriesID }
		hx-swap="innerHTML"
	/>
}

templ journalEntryList(data JournalPageData) {
	for _, entry := range data.Entries {
		@journalEntryCard(data.CharacterID, entry)
	}
	if len(data.Entries) == 0 {
		if data.Query == "" {
			<p class="text-base-content/70">Nothing written down yet. Start one with the New Entry button above.</p>
		} else {
			<p class="text-base-content/70">No entries match &#34;{ data.Query }&#34;.</p>
		}
	}
}

templ journalEntryCard(characterID string, entry JournalEntry) {
	{{ href := "/characters/" + characterID + "/edit/journal/" + entry.ID }}
	{{ action := "/characters/" + characterID + "/journal/" + entry.ID }}
	<article class="flex flex-wrap items-center justify-between gap-3 rounded-field border-2 border-base-300 p-3">
		<div class="grid gap-1">
			<a href={ href } class="font-medium hover:underline">{ journalEntryTitle(entry) }</a>
			<p class="flex flex-wrap gap-x-4 text-sm text-base-content/70">
				<span>
					Written&nbsp;
					<time datetime={ entry.Created.ISO }>{ entry.Created.Text }</time>
				</span>
				<span>
					Edited&nbsp;
					<time datetime={ entry.Updated.ISO }>{ entry.Updated.Text }</time>
				</span>
			</p>
		</div>
		<div class="flex items-center gap-2">
			<a href={ href } class="btn btn-soft btn-sm">View</a>
			<button
				type="button"
				class="btn btn-soft btn-error btn-sm"
				hx-confirm={ "You are about to delete " + journalEntryTitle(entry) + ". This action cannot be undone." }
				hx-delete={ action }
				hx-target="closest article"
				hx-swap="delete"
			>
				Delete
			</button>
		</div>
	</article>
}
