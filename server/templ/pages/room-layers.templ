package pages

import "tabletopper/internal/uievents"

templ RoomLayers(data RoomLayersData) {
	<div
		id="room-layers"
		hx-get={ data.Path() }
		hx-trigger={ uievents.Tabletop + " from:window" }
		hx-sync="this:queue last"
		hx-swap="outerHTML"
		class="flex flex-col gap-2"
	>
		<ul class="flex flex-col gap-1">
			for _, l := range data.Layers {
				@layerRow(data, l)
			}
		</ul>
		@addLayerForm(data)
	</div>
}

templ layerRow(data RoomLayersData, l RoomLayer) {
	<li class="rounded-field border border-base-300 p-1.5">
		<div class="flex items-center gap-1.5">
			<input
				type="radio"
				name="active-layer"
				class="radio radio-xs shrink-0"
				checked?={ l.Active }
				aria-label={ "Show " + l.Name + " to the players" }
				hx-post={ data.ActivatePath(l) }
				hx-trigger="change"
			/>
			<input
				type="text"
				name="name"
				value={ l.Name }
				maxlength={ LayerNameLimit }
				required
				aria-label="Layer name"
				class="input input-xs min-w-0 flex-1"
				hx-patch={ data.NamePath(l) }
				hx-trigger="change"
			/>
			<div class="tooltip tooltip-left shrink-0" data-tip="Move up">
				<button
					type="button"
					class="btn btn-ghost btn-xs px-1"
					aria-label={ "Move " + l.Name + " up" }
					disabled?={ l.Top }
					hx-post={ data.MovePath(l) }
					hx-vals={ data.MoveVals(l, 1) }
				>
					@chevronUpIcon()
				</button>
			</div>
			<div class="tooltip tooltip-left shrink-0" data-tip="Move down">
				<button
					type="button"
					class="btn btn-ghost btn-xs px-1"
					aria-label={ "Move " + l.Name + " down" }
					disabled?={ l.Bottom }
					hx-post={ data.MovePath(l) }
					hx-vals={ data.MoveVals(l, -1) }
				>
					@chevronDownIcon()
				</button>
			</div>
			<div class="tooltip tooltip-left shrink-0" data-tip="Delete floor">
				<button
					type="button"
					class="btn btn-ghost btn-xs px-1 text-base-content/50 hover:text-error"
					aria-label={ "Delete " + l.Name }
					hx-delete={ data.LayerPath(l) }
					hx-confirm={ data.RemovePrompt(l) }
					data-confirm-heading="Delete this layer?"
					data-confirm-label="Delete layer"
				>
					@trashLineIcon()
				</button>
			</div>
		</div>
		<div class="mt-1.5 flex flex-col gap-1 pl-6">
			for _, slot := range data.Slots(l) {
				@layerMapSlot(slot)
			}
		</div>
		if l.PawnLabel() != "" {
			<p class="mt-1 pl-6 text-[10px] leading-tight text-base-content/60">{ l.PawnLabel() }</p>
		}
	</li>
}

templ layerMapSlot(slot RoomLayerSlot) {
	<div class="flex items-center gap-2">
		<span class="w-16 shrink-0 text-[10px] leading-tight text-base-content/60">{ slot.Label }</span>
		if slot.Map.Set() && !slot.Map.Missing() {
			<img src={ slot.Map.PreviewURL() } alt="" class="size-8 shrink-0 rounded-sm object-cover"/>
			<div class="min-w-0 flex-1">
				<p class="truncate text-xs">{ slot.Map.Name }</p>
				<p class="text-[10px] text-base-content/60">{ slot.Map.Size() }</p>
				if slot.Map.Mismatch {
					<p class="text-[10px] leading-tight text-warning">{ roomLayerMismatch }</p>
				}
			</div>
		} else if slot.Map.Missing() {
			<p class="min-w-0 flex-1 text-xs text-warning">{ roomLayerMapGone }</p>
		} else {
			<p class="min-w-0 flex-1 text-xs text-base-content/60">{ slot.Empty }</p>
		}
		<button
			type="button"
			class="btn btn-xs shrink-0"
			data-modal-open={ slot.Picker }
			data-modal-size="xl"
		>Choose</button>
		if slot.Map.Set() {
			<button
				type="button"
				class="btn btn-ghost btn-xs shrink-0"
				hx-delete={ slot.Path }
			>Clear</button>
		}
	</div>
}

templ addLayerForm(data RoomLayersData) {
	<form
		hx-post={ data.AddPath() }
		hx-on::after-request="this.reset()"
		class="flex items-center gap-1"
	>
		<input
			type="text"
			name="name"
			placeholder="New floor"
			required
			maxlength={ LayerNameLimit }
			aria-label="Name for the new floor"
			class="input input-xs min-w-0 flex-1"
			disabled?={ data.Full }
		/>
		<button type="submit" class="btn btn-xs shrink-0" disabled?={ data.Full }>Add</button>
	</form>
	if data.Full {
		<p class="text-[10px] text-base-content/60">A room holds twenty floors, which is as many as this one has.</p>
	}
}
