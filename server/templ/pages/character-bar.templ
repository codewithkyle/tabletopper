package pages

const barGutter = "px-6 max-[900px]:px-4"

const tabGutter = "px-4"

templ appBar() {
	<header class="sticky top-0 z-20 border-b border-base-300 bg-panel/85 backdrop-blur-sm">
		{ children... }
	</header>
}

templ characterBar(characterID string, header CharacterHeader, active string, layout shellLayout) {
	@appBar() {
		<div class={ barGutter + " flex flex-wrap items-center gap-x-6 gap-y-3 pt-3 pb-2" }>
			@characterBarFigure(header, false)
			@characterBarChips(header, false)
			<div class="flex items-center gap-3 max-[640px]:w-full">
				<a href="/characters" class="btn max-[640px]:flex-1">Back</a>
				@characterShareButton(characterID)
				if layout.Actions != nil {
					@layout.Actions
				}
			</div>
		</div>
		@characterTabs(characterID, active)
		if layout.SubNav != nil {
			<div class="border-t border-base-300 bg-base-content/5">
				@layout.SubNav
			</div>
		}
	}
}

templ CharacterBarValues(header CharacterHeader) {
	@characterBarFigure(header, true)
	@characterBarChips(header, true)
}

templ characterBarFigure(header CharacterHeader, oob bool) {
	<div
		id="character-bar-figure"
		class="flex min-w-0 items-center gap-3"
		if oob {
			hx-swap-oob="true"
		}
	>
		<div class="avatar avatar-placeholder shrink-0 rounded-full border border-base-300">
			<div class="relative w-11 rounded-full bg-base-300 text-base-content">
				<span class="font-serif text-lg font-bold">{ characterInitial(header.Name) }</span>
				if header.AvatarID != "" {
					<img class="absolute inset-0 h-full w-full rounded-full object-cover select-none" src={ "/assets/images/" + header.AvatarID } alt={ header.Name + " portrait" }/>
				}
			</div>
		</div>
		<div class="min-w-0">
			<h1 class="m-0 truncate font-serif text-2xl leading-tight">{ characterBarName(header) }</h1>
			if header.Subtitle != "" {
				<p class="m-0 mt-0.5 truncate text-xs text-base-content/65">{ header.Subtitle }</p>
			}
		</div>
	</div>
}

templ characterBarChips(header CharacterHeader, oob bool) {
	<dl
		id="character-bar-chips"
		class="m-0 ml-auto flex flex-wrap items-stretch gap-2 max-[900px]:ml-0"
		if oob {
			hx-swap-oob="true"
		}
	>
		for _, chip := range characterChips(header) {
			<div class="min-w-18 rounded-field border border-base-300 bg-base-content/5 px-3 py-1 text-center">
				<dt class="text-[0.58rem] font-semibold tracking-[0.11em] uppercase text-base-content/60">{ chip.Label }</dt>
				<dd class="m-0 mt-0.5 text-lg leading-tight font-extrabold tabular-nums">
					{ chip.Value }
					if chip.Sub != "" {
						<span class="text-xs font-semibold text-base-content/60">{ chip.Sub }</span>
					}
				</dd>
			</div>
		}
	</dl>
}

templ characterShareButton(characterID string) {
	<button
		type="button"
		class="btn max-[640px]:flex-1"
		data-modal-open={ characterShareDialogURL(characterID) }
	>
		@shareIcon()
		Share character
	</button>
}
