package layouts

templ Base(title string, scripts ...string) {
	<!DOCTYPE html>
	<html { themeAttrs(ctx)... }>
		<head>
			<title>{ title }</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ `{"noSwap":[204,304,"4xx","5xx"]}` }/>
			<link rel="stylesheet" href={ Asset("/css/app.css") }/>
			<link rel="stylesheet" href={ Asset("/css/core.css") }/>
			<link rel="stylesheet" href={ Asset("/css/soft-loading.css") }/>
			<link rel="stylesheet" href={ Asset("/css/toast.css") }/>
			<link rel="stylesheet" href={ Asset("/css/journal.css") }/>
			<script defer src={ Asset("/static/htmx.min.js") }></script>
			<script type="module" src={ Asset("/js/loading.js") }></script>
			<script type="module" src={ Asset("/js/toast.js") }></script>
			<script type="module" src={ Asset("/js/repeater.js") }></script>
			<script type="module" src={ Asset("/js/form-validity.js") }></script>
			<script type="module" src={ Asset("/js/confirm-modal.js") }></script>
			<script type="module" src={ Asset("/js/alert-modal.js") }></script>
			<script type="module" src={ Asset("/js/content-modal.js") }></script>
			<script type="module" src={ Asset("/js/theme.js") }></script>
			<script type="module" src={ Asset("/js/share-link.js") }></script>
			<script type="module" src={ Asset("/js/range-output.js") }></script>
			<script type="module" src={ Asset("/js/notify-permission.js") }></script>
			<script type="module" src={ Asset("/static/sound-preview.js") }></script>
			for _, src := range scripts {
				<script type="module" src={ Asset(src) }></script>
			}
		</head>
		<body>
			<soft-loading>
				<transition-bar-one></transition-bar-one>
				<transition-bar-two></transition-bar-two>
			</soft-loading>
			<main class="w-full h-full flex flex-col flex-wrap items-center justify-center">
				{ children... }
			</main>
			@confirmModal()
			@alertModal()
			@contentModal()
		</body>
	</html>
}

templ confirmModal() {
	<dialog id="confirm-modal" class="modal backdrop-blur-[4px]" aria-labelledby="confirm-modal-heading">
		<div class="modal-box border border-base-300 bg-panel/85 shadow-panel backdrop-blur-sm">
			<h4 id="confirm-modal-heading" class="mb-3 block text-xl font-semibold" data-modal-heading></h4>
			<p class="block" data-modal-message></p>
			<form method="dialog" class="modal-action">
				<button class="btn border-base-content/50" value="cancel" autofocus data-modal-cancel>Close</button>
				<button class="btn btn-error" value="confirm" data-modal-confirm>Confirm</button>
			</form>
		</div>
	</dialog>
}

templ alertModal() {
	<dialog id="alert-modal" class="modal backdrop-blur-[4px]" aria-labelledby="alert-modal-heading">
		<div class="modal-box border border-base-300 bg-panel/85 shadow-panel backdrop-blur-sm">
			<h4 id="alert-modal-heading" class="mb-3 block text-xl font-semibold" data-modal-heading></h4>
			<p class="block" data-modal-message></p>
			<form method="dialog" class="modal-action">
				<button class="btn border-base-content/50" autofocus>Close</button>
			</form>
		</div>
	</dialog>
}

templ contentModal() {
	<dialog id="content-modal" class="modal backdrop-blur-[4px]">
		<div class="modal-box border border-base-300 bg-panel/85 shadow-panel backdrop-blur-sm" data-modal-box>
			<div data-modal-loading>
				<div class="flex min-h-32 items-center justify-center">
					<span class="loading loading-spinner loading-lg"></span>
				</div>
				<form method="dialog" class="modal-action">
					<button class="btn border-base-content/50">Close</button>
				</form>
			</div>
			<div data-modal-error hidden>
				<div class="min-h-32 content-center text-center">
					<h4 class="mb-3 block text-xl font-semibold">Couldn't load that</h4>
					<p class="block">The server didn't return the content. Try again in a moment.</p>
				</div>
				<div class="modal-action">
					<form method="dialog">
						<button class="btn border-base-content/50">Close</button>
					</form>
					<button class="btn btn-primary" data-modal-retry>Retry</button>
				</div>
			</div>
			<div data-modal-body hidden></div>
		</div>
	</dialog>
}
