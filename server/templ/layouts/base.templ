package layouts

import "main/internal/session"

type BaseTemplateSettings struct {
	Title   string
	Content templ.Component
	Session session.UserSession
}

templ Base(settings BaseTemplateSettings) {
	<!DOCTYPE html>
	<html>
		<head hx-head="append">
			<title>{ settings.Title }</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			// NOTE: htmx 4 swaps error responses by default. Ours are header-only
			// (HX-Trigger alerts) with an empty body, so swapping one would wipe
			// the target. 422 is exempt: those carry real form-error markup and
			// are routed by hx-status:422 on the character forms.
			<meta name="htmx-config" content={ `{"noSwap":[204,304,"4xx","5xx"]}` }/>
			<link rel="stylesheet" href="/css/app.css"/>
			<link rel="stylesheet" href="/css/core.css"/>
			<link rel="stylesheet" href="/css/normalize.css"/>
			<link rel="stylesheet" href="/css/tokens.css"/>
			<link rel="stylesheet" href="/css/soft-loading.css"/>
			<link rel="stylesheet" href="/css/bootstrap.css"/>
			<link rel="stylesheet" href="/css/animations.css"/>
			<link rel="stylesheet" href="/css/toast.css"/>
			<link rel="stylesheet" href="/css/select.css"/>
			<link rel="stylesheet" href="/css/monster-info-table.css"/>
			<link rel="stylesheet" href="/css/skills-table.css"/>
			<link rel="stylesheet" href="/css/saving-throws-table.css"/>
			<link rel="stylesheet" href="/css/spell-slots-table.css"/>
			<script defer src="/static/htmx.min.js"></script>
			<script defer src="/static/hx-head.min.js"></script>
			<script defer src="/static/alpine.min.js"></script>
			<script type="module" src="/js/confirm-modal.js"></script>
			<script type="module" src="/js/notif.js"></script>
			<script type="module" src="/js/select.js"></script>
			<script type="module" src="/js/monster-info-table.js"></script>
			<script type="module" src="/js/skills-table.js"></script>
			<script type="module" src="/js/saving-throws-table.js"></script>
			<script type="module" src="/js/spell-slots-table.js"></script>
			<style>[x-cloak] { display: none !important; }</style>
		</head>
		<body>
			<soft-loading>
				<transition-bar-one></transition-bar-one>
				<transition-bar-two></transition-bar-two>
			</soft-loading>
			<main class="w-full h-full flex flex-col flex-wrap items-center justify-center">
				@settings.Content
			</main>
			<modal-element
				class="fixed top-0 left-0 z-[9000] flex h-screen w-screen flex-col content-center justify-center"
				x-data="{ show: false, confirmLabel:'', cancelLabel:'', heading:'', message:'', uid:'' }"
				x-cloak
				x-show="show"
				x-on:show-confirm-modal.window="uid = $event.detail.uid; heading = $event.detail.heading; message = $event.detail.message; confirmLabel = $event.detail.confirmLabel; cancelLabel = $event.detail.cancelLabel; show = true;"
			>
				<modal-background class="absolute top-0 left-0 h-full w-full bg-black/40 backdrop-blur-[4px]"></modal-background>
				<modal-content class="relative m-auto inline-block max-h-screen max-w-screen overflow-y-auto rounded-box border-2 border-base-300 bg-base-200/85 p-6 shadow-sm backdrop-blur-sm">
					<h4
						class="block text-xl font-semibold mb-3"
						x-text="heading"
					></h4>
					<p
						class="block mb-6"
						x-text="message"
					></p>
					<div class="w-full flex flex-row flex-nowrap items-center justify-end">
						<button
							class="btn mr-2"
							x-text="cancelLabel"
							x-on:click="show = false; $dispatch('confirm-modal:cancel', uid);"
						>Close</button>
						<button
							class="btn btn-error"
							x-text="confirmLabel"
							x-on:click="show = false; $dispatch('confirm-modal:confirm', uid);"
						></button>
					</div>
				</modal-content>
			</modal-element>
			<modal-element
				class="fixed top-0 left-0 z-[9000] flex h-screen w-screen flex-col content-center justify-center"
				x-data="{ show: false, heading:'', message:'', uid:'' }"
				x-cloak
				x-show="show"
				x-on:alert.window="uid = $event.detail.uid; heading = $event.detail.heading; message = $event.detail.message; show = true;"
			>
				<modal-background class="absolute top-0 left-0 h-full w-full bg-black/40 backdrop-blur-[4px]"></modal-background>
				<modal-content class="relative m-auto inline-block max-h-screen max-w-screen overflow-y-auto rounded-box border-2 border-base-300 bg-base-200/85 p-6 shadow-sm backdrop-blur-sm">
					<h4
						class="block text-xl font-semibold mb-3"
						x-text="heading"
					></h4>
					<p
						class="block mb-6"
						x-text="message"
					></p>
					<div class="w-full flex flex-row flex-nowrap items-center justify-end">
						<button
							class="btn"
							x-on:click="show = false;"
						>Close</button>
					</div>
				</modal-content>
			</modal-element>
		</body>
	</html>
}
