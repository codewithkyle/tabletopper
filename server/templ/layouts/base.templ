package layouts

import "main/internal/session"

type BaseTemplateSettings struct {
    Title string
    Content templ.Component
    Session session.UserSession
}

templ Base(settings BaseTemplateSettings) {
    <!DOCTYPE html>
    <html>
        <head hx-head="append">
            <title>{ settings.Title }</title>

            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">

            <link rel="stylesheet" href="/css/core.css">
            <link rel="stylesheet" href="/css/normalize.css">
            <link rel="stylesheet" href="/css/brixi.css">
            <link rel="stylesheet" href="/css/bootstrap.css">
            <link rel="stylesheet" href="/css/modal-element.css">

            <link rel="stylesheet" href="/css/animations.css">
            <link rel="stylesheet" href="/css/snackbar.css">
            <link rel="stylesheet" href="/css/notifications.css">
            <link rel="stylesheet" href="/css/button.css">
            <link rel="stylesheet" href="/css/input.css">
            <link rel="stylesheet" href="/css/homepage.css">
            <link rel="stylesheet" href="/css/tooltip.css">
            <link rel="stylesheet" href="/css/link.css">
            <link rel="stylesheet" href="/css/skeletons.css">
            <link rel="stylesheet" href="/css/input.css">
            <link rel="stylesheet" href="/css/select.css">
            <link rel="stylesheet" href="/css/lightswitch.css">
            <link rel="stylesheet" href="/css/monster-info-table.css">
            <link rel="stylesheet" href="/css/skills-table.css">
            <link rel="stylesheet" href="/css/saving-throws-table.css">
            <link rel="stylesheet" href="/css/spell-slots-table.css">
            <link rel="stylesheet" href="/css/character-sheet.css">
            <link rel="stylesheet" href="/css/character-cards.css">

            <script defer src="/static/htmx.min.js"></script>
            <script defer src="/static/htmx.response-targets.min.js"></script>
            <script defer src="/static/alpine.min.js"></script>
            <script type="module" src="/js/bootstrap.js"></script>
            <script type="module" src="/js/tooltipper.js"></script>
            <script type="module" src="/js/confirm-modal.js"></script>

            <script type="module" src="/js/lightswitch.js"></script>
            <script type="module" src="/js/select.js"></script>
            <script type="module" src="/js/input.js"></script>
            <script type="module" src="/js/number-input.js"></script>
            <script type="module" src="/js/monster-info-table.js"></script>
            <script type="module" src="/js/skills-table.js"></script>
            <script type="module" src="/js/saving-throws-table.js"></script>
            <script type="module" src="/js/spell-slots-table.js"></script>

            <style>[x-cloak] { display: none !important; }</style>
        </head>
        <body hx-ext="preload,response-targets,head-support">
            <main class="w-full h-full" flex="justify-center items-center column wrap">
                @settings.Content
            </main>
            <modal-element
                x-data="{ show: false, confirmLabel:'', cancelLabel:'', heading:'', message:'', uid:'' }"
                x-cloak
                x-show="show"
                x-on:show-confirm-modal.window="uid = $event.detail.uid; heading = $event.detail.heading; message = $event.detail.message; confirmLabel = $event.detail.confirmLabel; cancelLabel = $event.detail.cancelLabel; show = true;"
            >
                <modal-background></modal-background>
                <modal-content class="p-1.5">
                    <h4 
                        class="block font-lg font-semibold mb-0.75"
                        style="color: var(--sheet-accent);"
                        x-text="heading"
                    ></h4>
                    <p 
                        class="block mb-1.5"
                        style="color: var(--sheet-ink);"
                        x-text="message"
                    ></p>
                    <div class="w-full" flex="row nowrap items-center justify-end">
                        <button 
                            class="bttn mr-0.5"
                            color="grey"
                            kind="solid"
                            x-text="cancelLabel"
                            x-on:click="show = false; $dispatch('confirm-modal:cancel', uid);"
                        >Close</button>
                        <button 
                            class="bttn"
                            color="danger"
                            kind="solid"
                            x-text="confirmLabel"
                            x-on:click="show = false; $dispatch('confirm-modal:confirm', uid);"
                        ></button>
                    </div>
                </modal-content>
            </modal-element>
        </body>
    </html>
}
