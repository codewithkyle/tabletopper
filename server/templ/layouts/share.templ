package layouts

const shareColumn = "mx-auto grid w-full content-start gap-4 p-4 max-[700px]:p-2.5"

const shareColumnNarrow = shareColumn + " max-w-3xl"

const shareColumnWide = shareColumn + " max-w-6xl"

templ Share(title string, wide bool) {
	{{ columnClass := shareColumnNarrow }}
	if wide {
		{{ columnClass = shareColumnWide }}
	}
	<!DOCTYPE html>
	<html>
		<head>
			<title>{ title }</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex, nofollow"/>
			<meta name="referrer" content="no-referrer"/>
			<link rel="stylesheet" href="/css/app.css"/>
			<link rel="stylesheet" href="/css/core.css"/>
			<link rel="stylesheet" href="/css/journal.css"/>
		</head>
		<body>
			<main class="h-full w-full overflow-auto">
				<div class={ columnClass }>
					{ children... }
				</div>
			</main>
		</body>
	</html>
}
