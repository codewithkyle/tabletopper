{
	"compilerOptions": {
		"strict": true,
		"allowJs": true,
		"noEmit": true,
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["node"],
		"forceConsistentCasingInFileNames": true
	},
	"include": ["room/**/*.ts"]
}
